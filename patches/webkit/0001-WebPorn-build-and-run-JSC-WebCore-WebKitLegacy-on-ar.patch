+# WebPorn: WebKitLegacy for iOS (WK_IOS_TARGET), included from PlatformMac.cmake.
+# Sources mirror the Xcode build: Sources.txt + SourcesCocoa.txt plus the files Xcode
+# compiles outside unified bundles (mac/ files are shared with iOS, guarded inside),
+# minus EXCLUDED_SOURCE_FILE_NAMES_cocoatouch from mac/Configurations/WebKitLegacy.xcconfig.
+
+foreach (_wp_framework CFNetwork CoreGraphics CoreText Foundation ImageIO MobileCoreServices QuartzCore Security SystemConfiguration UIKit)
+    find_library(_wp_${_wp_framework}_LIBRARY ${_wp_framework})
+    list(APPEND WebKitLegacy_PRIVATE_LIBRARIES ${_wp_${_wp_framework}_LIBRARY})
+endforeach ()
+list(APPEND WebKitLegacy_PRIVATE_LIBRARIES "-lobjc" "${WK26_ICU_DYLIB}")
+
+add_definitions(-DJSC_CLASS_AVAILABLE\\\(...\\\)=)
+add_definitions(-fobjc-weak)
+
+list(APPEND WebKitLegacy_PRIVATE_INCLUDE_DIRECTORIES
+    "${PAL_FRAMEWORK_HEADERS_DIR}"
+    "${WEBKITLEGACY_DIR}"
+    "${WEBKITLEGACY_DIR}/ios"
+    "${WEBKITLEGACY_DIR}/ios/DefaultDelegates"
+    "${WEBKITLEGACY_DIR}/ios/Misc"
+    "${WEBKITLEGACY_DIR}/ios/WebCoreSupport"
+    "${WEBKITLEGACY_DIR}/ios/WebView"
+    "${WEBKITLEGACY_DIR}/mac"
+    "${WEBKITLEGACY_DIR}/mac/Misc"
+    "${WEBKITLEGACY_DIR}/mac/WebView"
+    "${WEBKITLEGACY_DIR}/mac/WebCoreSupport"
+    "${WebKitLegacy_FRAMEWORK_HEADERS_DIR}"
