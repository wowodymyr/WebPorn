+# (see MachineContext.h), and Web Port ran with it off on armv7.
+if (WK_IOS_TARGET AND WTF_CPU_ARM)
+    WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBASSEMBLY PRIVATE OFF)
