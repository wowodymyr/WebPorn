diff --git a/Source/JavaScriptCore/offlineasm/arm.rb b/Source/JavaScriptCore/offlineasm/arm.rb
index e82809c92a..7f9df2d081 100644
--- a/Source/JavaScriptCore/offlineasm/arm.rb
+++ b/Source/JavaScriptCore/offlineasm/arm.rb
@@ -90,6 +90,19 @@ ARM_EXTRA_GPRS = [SpecialRegister.new("r9"), SpecialRegister.new("lr"), SpecialR
 ARM_SCRATCH_FPR = SpecialRegister.new("d7")
 OS_DARWIN = ((RUBY_PLATFORM =~ /darwin/i) != nil)
 
+# WebPorn: load a link-time 32-bit expression (label differences) from an inline literal.
+# LLVM rejects movw/movt fixups whose addend does not fit in 16 bits, and LLInt label
+# differences are megabytes; a .long fixup has no such limit.
+def armLoadLiteral(expr, register)
+    uid = $asm.newUID
+    $asm.puts "ldr #{register.armOperand}, Ljsc_llint_lit_#{uid}"
+    $asm.puts "b Ljsc_llint_lit_skip_#{uid}"
+    $asm.puts ".p2align 2"
+    $asm.puts "Ljsc_llint_lit_#{uid}:"
+    $asm.puts ".long #{expr}"
+    $asm.puts "Ljsc_llint_lit_skip_#{uid}:"
+end
+
 def armMoveImmediate(value, register)
     # Currently we only handle the simple cases, and fall back to mov/movt for the complex ones.
     if value.is_a? String
@@ -766,8 +779,7 @@ class Instruction
             armMoveImmediate(operands[0].value >> 32, operands[1])
             armMoveImmediate(operands[0].value & 0xffffffff, operands[2])
         when "mvlbl"
-                $asm.puts "movw #{operands[1].armOperand}, \#:lower16:#{operands[0].value}"
-                $asm.puts "movt #{operands[1].armOperand}, \#:upper16:#{operands[0].value}"
+            armLoadLiteral(operands[0].value, operands[1])
         when "sxb2i"
             $asm.puts "sxtb #{armFlippedOperands(operands)}"
         when "sxh2i"
@@ -962,6 +974,17 @@ class Instruction
 
             uid = $asm.newUID
 
+            # WebPorn: labels defined in the LLInt blob itself are local ("L...") on Darwin and
+            # cannot get a non-lazy pointer (.indirect_symbol needs a non-local symbol); address
+            # them PC-relatively. This yields the raw address, like the Linux GOT path.
+            if not labelRef.extern?
+                $asm.putStr("#if OS(DARWIN)")
+                armLoadLiteral("#{labelRef.asmLabel}-(Ljsc_llint_#{uid}+4)", dest)
+                $asm.puts "Ljsc_llint_#{uid}:"
+                $asm.puts "add #{dest.armOperand}, pc"
+                $asm.putStr("#else")
+            end
+
             $asm.putStr("#if OS(DARWIN)")
             $asm.puts "movw #{operands[1].armOperand}, :lower16:(L#{operands[0].asmLabel}_#{uid}$non_lazy_ptr-(Ljsc_llint_#{uid}+4))"
             $asm.puts "movt #{operands[1].armOperand}, :upper16:(L#{operands[0].asmLabel}_#{uid}$non_lazy_ptr-(Ljsc_llint_#{uid}+4))"
@@ -984,10 +1007,12 @@ class Instruction
             $asm.putStr("#else")
             $asm.putStr("#error Missing globaladdr implementation")
             $asm.putStr("#endif")
+            $asm.putStr("#endif") if not labelRef.extern?
 
             offset = 4
 
             $asm.deferNextLabelAction {
+                $asm.putStr("#if !OS(DARWIN)") if not labelRef.extern?
                 $asm.putStr("#if OS(DARWIN)")
                 $asm.puts ".section __DATA,__nl_symbol_ptr,non_lazy_symbol_pointers"
                 $asm.puts ".p2align 2"
@@ -1007,6 +1032,7 @@ class Instruction
                 $asm.puts ".word #{labelRef.asmLabel}(GOT)"
 
                 $asm.putStr("#endif")
+                $asm.putStr("#endif") if not labelRef.extern?
             }
         else
             lowerDefault
