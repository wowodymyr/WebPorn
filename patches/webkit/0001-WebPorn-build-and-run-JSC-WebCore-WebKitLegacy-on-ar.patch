+)
+
+# WebCore headers WebKitLegacy re-exports as <WebKitLegacy/...> (MigratedHeaders-input.xcfilelist),
+# transformed like scripts/migrate-header-rule does.
+file(STRINGS "${WEBKITLEGACY_DIR}/MigratedHeaders-input.xcfilelist" _wp_migrated REGEX "^\\$\\(WEBCORE_PRIVATE_HEADERS_DIR\\)/")
+foreach (_wp_entry ${_wp_migrated})
+    string(REGEX REPLACE "^.*/" "" _wp_name "${_wp_entry}")
+    file(GLOB_RECURSE _wp_source "${WEBCORE_DIR}/*/${_wp_name}")
+    list(FILTER _wp_source EXCLUDE REGEX "/(mac|testing)/")
+    list(GET _wp_source 0 _wp_source)
+    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_wp_source}")
+    file(READ "${_wp_source}" _wp_text)
+    string(REPLACE "<WebCore/" "<WebKitLegacy/" _wp_text "${_wp_text}")
+    string(REGEX REPLACE "(\n *)WEBCORE_EXPORT " "\\1" _wp_text "${_wp_text}")
+    file(WRITE "${WebKitLegacy_FRAMEWORK_HEADERS_DIR}/WebKitLegacy/${_wp_name}.tmp" "${_wp_text}")
+    file(COPY_FILE "${WebKitLegacy_FRAMEWORK_HEADERS_DIR}/WebKitLegacy/${_wp_name}.tmp"
+        "${WebKitLegacy_FRAMEWORK_HEADERS_DIR}/WebKitLegacy/${_wp_name}" ONLY_IF_DIFFERENT)
+    file(REMOVE "${WebKitLegacy_FRAMEWORK_HEADERS_DIR}/WebKitLegacy/${_wp_name}.tmp")
+endforeach ()
