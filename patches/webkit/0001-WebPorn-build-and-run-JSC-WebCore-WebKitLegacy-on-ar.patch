 #define _STORE_IN_DLSYM_SECTION __attribute__((section("__TEXT,__dlsym_cstr")))
 #define _STORE_IN_GETCLASS_SECTION __attribute__((section("__TEXT,__getClass_cstr")))
 
+// WebPorn: on the old iOS targets a "hard" soft-link to an API newer than the OS
+// must not take the process down. A missing framework, function, constant,
+// pointer or class is logged and degrades to a no-op returning a zero value (nil
+// for objects and classes), as Web Port's runtime stubs library did. C and
+// Objective-C (non-C++) sources keep the original crash.
+#if defined(WK26_IOS_TARGET) && defined(__cplusplus)
+#include <type_traits>
+namespace WTF {
+template<typename T> inline T softLinkZero() { return T(); }
+// Stands in for a missing function of any signature returning R: the caller
+// cleans up the arguments (AAPCS, AAPCS64), and the result convention depends on
+// R alone, so calling it through the real function's pointer type is safe.
+template<typename R> R softLinkZeroStub()
+{
+    if constexpr (!std::is_void_v<R>)
+        return R();
+}
+}
+#define WEBPORN_SOFT_LINK_MISSING(what) WTFLogAlways("WebPorn: soft-link unavailable on this iOS: %s", what)
+#define WEBPORN_SOFT_LINK_CHECK(value, what) do { if (!(value)) WEBPORN_SOFT_LINK_MISSING(what); } while (0)
+#define WEBPORN_SOFT_LINK_FUNCTION(pointer, resultType, what) do { if (!(pointer)) { WEBPORN_SOFT_LINK_MISSING(what); pointer = reinterpret_cast<decltype(pointer)>(&WTF::softLinkZeroStub<resultType>); } } while (0)
+#define WEBPORN_SOFT_LINK_DEREF(type, address) ((address) ? *static_cast<type const *>(address) : WTF::softLinkZero<type>())
+#define WEBPORN_SOFT_LINK_POINTEE(type, address) ((address) ? static_cast<type>(*(address)) : WTF::softLinkZero<type>())
+#else
+#define WEBPORN_SOFT_LINK_CHECK(value, what) RELEASE_ASSERT_WITH_MESSAGE(value, "%s", dlerror())
+#define WEBPORN_SOFT_LINK_FUNCTION(pointer, resultType, what) RELEASE_ASSERT_WITH_MESSAGE(pointer, "%s", dlerror())
+#define WEBPORN_SOFT_LINK_DEREF(type, address) (*static_cast<type const *>(address))
+#define WEBPORN_SOFT_LINK_POINTEE(type, address) (static_cast<type>(*(address)))
+#endif
+
