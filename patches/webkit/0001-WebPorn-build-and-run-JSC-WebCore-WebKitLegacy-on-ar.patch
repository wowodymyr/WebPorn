@@ -228,8 +228,23 @@ void Thread::initializeInThread()
 #endif
 }
 
+// WebPorn: armv7 iOS starts threads with VFP flush-to-zero on, which breaks IEEE
+// denormals (Number.MIN_VALUE == 0). Turn it off on every WTF thread and on the
+// thread that initializes WTF (WebCore's FloatingPointEnvironment only covers the
+// UI and web threads; JIT compiler threads constant-fold doubles too).
+static inline void disableFlushToZeroIfNeeded()
+{
+#if OS(DARWIN) && CPU(ARM_THUMB2)
+    unsigned fpscr;
+    __asm__ volatile("vmrs %0, fpscr" : "=r"(fpscr));
+    fpscr &= ~0x01000000u;
+    __asm__ volatile("vmsr fpscr, %0" : : "r"(fpscr));
+#endif
+}
+
 void Thread::entryPoint(NewThreadContext* newThreadContext)
 {
+    disableFlushToZeroIfNeeded();
     Function<void()> function;
     {
         // Ref is already incremented by Thread::create.
@@ -478,6 +493,7 @@ static bool hasDisableTZoneEntitlement()
 
 void initialize()
 {
+    disableFlushToZeroIfNeeded();
     static std::once_flag onceKey;
     std::call_once(onceKey, [] {
 #if ENABLE(CONJECTURE_ASSERT)
