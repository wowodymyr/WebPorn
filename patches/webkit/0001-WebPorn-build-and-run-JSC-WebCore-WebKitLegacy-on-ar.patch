diff --git a/Source/WebCore/PlatformIOS.cmake b/Source/WebCore/PlatformIOS.cmake
new file mode 100644
index 0000000000..f817d4d427
--- /dev/null
+++ b/Source/WebCore/PlatformIOS.cmake
@@ -0,0 +1,342 @@
+# WebPorn: WebCore for iOS (WK_IOS_TARGET), included from PlatformMac.cmake.
+# Sources mirror the Xcode build: Sources.txt + SourcesCocoa.txt (unified, platform
+# guards inside the files) plus the files Xcode compiles outside unified bundles.
+
+find_library(ACCELERATE_LIBRARY Accelerate)
+find_library(AUDIOTOOLBOX_LIBRARY AudioToolbox)
+find_library(AVFOUNDATION_LIBRARY AVFoundation)
+find_library(CFNETWORK_LIBRARY CFNetwork)
+find_library(COREAUDIO_LIBRARY CoreAudio)
+find_library(COREGRAPHICS_LIBRARY CoreGraphics)
+find_library(COREIMAGE_LIBRARY CoreImage)
+find_library(COREMEDIA_LIBRARY CoreMedia)
+find_library(CORETEXT_LIBRARY CoreText)
+find_library(COREVIDEO_LIBRARY CoreVideo)
+find_library(FOUNDATION_LIBRARY Foundation)
+find_library(IMAGEIO_LIBRARY ImageIO)
+find_library(MOBILECORESERVICES_LIBRARY MobileCoreServices)
+find_library(OPENGLES_LIBRARY OpenGLES)
+find_library(QUARTZCORE_LIBRARY QuartzCore)
+find_library(SECURITY_LIBRARY Security)
+find_library(SYSTEMCONFIGURATION_LIBRARY SystemConfiguration)
+find_library(UIKIT_LIBRARY UIKit)
+find_library(VIDEOTOOLBOX_LIBRARY VideoToolbox)
+
+find_package(SQLite3 REQUIRED)
+find_package(ZLIB REQUIRED)
+
+list(APPEND WebCore_UNIFIED_SOURCE_LIST_FILES
+    "SourcesCocoa.txt"
+)
+
+list(APPEND WebCore_LIBRARIES
+    ${ACCELERATE_LIBRARY}
+    ${AUDIOTOOLBOX_LIBRARY}
+    ${AVFOUNDATION_LIBRARY}
+    ${CFNETWORK_LIBRARY}
+    ${COREAUDIO_LIBRARY}
+    ${COREGRAPHICS_LIBRARY}
+    ${COREIMAGE_LIBRARY}
+    ${COREMEDIA_LIBRARY}
+    ${CORETEXT_LIBRARY}
+    ${COREVIDEO_LIBRARY}
+    ${FOUNDATION_LIBRARY}
+    ${IMAGEIO_LIBRARY}
+    ${MOBILECORESERVICES_LIBRARY}
+    ${OPENGLES_LIBRARY}
+    ${QUARTZCORE_LIBRARY}
+    ${SECURITY_LIBRARY}
+    ${SYSTEMCONFIGURATION_LIBRARY}
+    ${UIKIT_LIBRARY}
+    ${VIDEOTOOLBOX_LIBRARY}
+    ${SQLITE3_LIBRARIES}
+    ${ZLIB_LIBRARIES}
+    xml2
+    "${WK26_ICU_DYLIB}"
+)
+
+# Private frameworks, linked through stubs made from the device's shared cache
+# (toolchain/make-tbd.py) so the binary records their real install names.
+foreach (_wp_stub IOSurface IOSurfaceAccelerator GraphicsServices libMobileGestalt libAccessibility libFontParser AppSupport IOKit)
+    list(APPEND WebCore_LIBRARIES "${WEBPORN_STUBS_DIR}/${_wp_stub}.tbd")
+endforeach ()
+
+list(APPEND WebCore_PRIVATE_INCLUDE_DIRECTORIES
+    "${WEBCORE_DIR}/platform/graphics/cocoa/controls"
+    "${WEBCORE_DIR}/platform/graphics/coretext"
+    "${WEBCORE_DIR}/platform/graphics/re"
+    "${WEBCORE_DIR}/platform/image-decoders"
+    "${WEBCORE_DIR}/Modules/system-preview"
+    "${WEBCORE_DIR}/Modules/webauthn/apdu"
+    "${WEBCORE_DIR}/accessibility/isolatedtree/mac"
+    "${WEBCORE_DIR}/accessibility/mac"
+    "${WEBCORE_DIR}/bridge/objc"
+    "${WEBCORE_DIR}/crypto/mac"
+    "${WEBCORE_DIR}/dom/mac"
+    "${WEBCORE_DIR}/editing/cocoa"
+    "${WEBCORE_DIR}/editing/mac"
+    "${WEBCORE_DIR}/html/shadow/cocoa"
+    "${WEBCORE_DIR}/layout/tableformatting"
+    "${WEBCORE_DIR}/loader/archive/cf"
+    "${WEBCORE_DIR}/loader/cf"
+    "${WEBCORE_DIR}/loader/cocoa"
+    "${WEBCORE_DIR}/loader/mac"
