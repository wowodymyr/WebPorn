+# WebPorn: bmalloc keys Apple platform detection off WK26_IOS_TARGET; the WK26
+# log/diagnostic code tests WK26_ENGINE_DIAG with #if, so give it a value.
+if (WK_IOS_TARGET)
+    if (NOT DEFINED WK26_ENGINE_DIAG)
+        set(WK26_ENGINE_DIAG 0)
+    endif ()
+    add_compile_definitions(WK26_IOS_TARGET=1 WK26_ENGINE_DIAG=${WK26_ENGINE_DIAG})
+    # clang 21 reports __has_feature(modules) for C++20+; WebKit SPI headers would go empty.
+    add_compile_definitions(WEBPORN_NO_CLANG_MODULES=1)
+    # No Swift (CryptoKit) on these targets: take the non-Swift crypto paths, as Web Port did.
+    add_compile_definitions(CLANG_WEBKIT_BRANCH=1)
+    # mediaparserd sandboxed parsing is for MSE (off), and the public SDK lacks AVStreamDataParser.
+    add_compile_definitions(USE_MEDIAPARSERD=0)
+    # The Web Port diff uses these diagnostics helpers but does not ship their definitions.
+    if (NOT WK26_ENGINE_DIAG)
+        # Function-style macros: add_compile_definitions drops these, pass them as flags.
+        add_compile_options("-DWK26_DATALOG(...)=((void)0)" "-DWK26_WTFLOG(...)=((void)0)" "-DWK26_ENGINE_FLAG(path)=0")
+    endif ()
+    # mbmalloc/MallocBench (DEVELOPER_MODE) link Threads::Threads.
+    find_package(Threads REQUIRED)
+    # clang 21 warns where Xcode's clang did not.
+    add_compile_options(-Wno-shadow-ivar)
+    # SDK CF_ENUM expands to "typedef enum X : T X;", a default error in clang 21 C++.
+    add_compile_options(-Wno-elaborated-enum-base)
+    # Newer-than-deployment API use is reviewed from the build log, not fatal:
+    # type-only uses (traits, declarations) are harmless on old iOS.
+    add_compile_options(-Wno-error=unguarded-availability -Wno-error=unguarded-availability-new)
+endif ()
