+            ENABLE_ORIENTATION_EVENTS ENABLE_TOUCH_EVENTS ENABLE_WEBKIT_OVERFLOW_SCROLLING_CSS_PROPERTY)
+        WEBKIT_OPTION_DEFAULT_PORT_VALUE(${_wp_feature} PRIVATE ON)
+    endforeach ()
+endif ()
