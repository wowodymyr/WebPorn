+            ENABLE_MOUSE_CURSOR_SCALE ENABLE_PAYMENT_REQUEST ENABLE_PDFKIT_PLUGIN
+            ENABLE_PICTURE_IN_PICTURE_API ENABLE_POINTER_LOCK ENABLE_SANDBOX_EXTENSIONS
+            ENABLE_SERVICE_CONTROLS
+            ENABLE_WEBDRIVER_KEYBOARD_INTERACTIONS ENABLE_WEBDRIVER_MOUSE_INTERACTIONS
+            ENABLE_WEBDRIVER_WHEEL_INTERACTIONS ENABLE_WEBXR ENABLE_WEB_API_STATISTICS
+            ENABLE_WEB_AUTHN ENABLE_WEB_RTC)
+        WEBKIT_OPTION_DEFAULT_PORT_VALUE(${_wp_feature} PRIVATE OFF)
+    endforeach ()
+    WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_LCMS PRIVATE OFF)
+    # On in PlatformEnableCocoa.h for iOS, but the CMake defaults would override it.
+    # TOUCH_EVENTS without IOS_TOUCH_EVENTS (Apple-internal sources), as Web Port does.
+    foreach (_wp_feature
