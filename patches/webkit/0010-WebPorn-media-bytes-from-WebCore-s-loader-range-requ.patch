+// MARK: - Stream
+
+bool MediaPlayerPrivateWebPorn::shouldStream(const URL& url) const
+{
+    // /var/webporn/media-direct: everything by URL, as before the stream input.
+    static bool direct = !access("/var/webporn/media-direct", F_OK);
+    if (direct || !(url.protocolIsInHTTPFamily() || url.protocolIsBlob() || url.protocolIsData()))
+        return false;
+    RefPtr player = m_player.get();
+    String type = player ? player->contentMIMEType().convertToASCIILowercase() : String();
+    if (type.contains("mpegurl"_s) || url.path().convertToASCIILowercase().endsWith(".m3u8"_s))
+        return false;
+    return true;
+}
+
+void MediaPlayerPrivateWebPorn::stopStreamLoad()
+{
+    if (RefPtr resource = std::exchange(m_resource, nullptr)) {
+        resource->setClient(nullptr);
+        resource->shutdown();
+    }
+}
+
+void MediaPlayerPrivateWebPorn::startStreamLoad(unsigned generation, uint64_t offset)
+{
+    RefPtr player = m_player.get();
+    if (!player || (generation && !m_streamOpened))
+        return;
+    stopStreamLoad();
+    m_streamGeneration = generation;
+    ResourceRequest request { URL { m_url } };
+    request.setHTTPHeaderField(HTTPHeaderName::Range, makeString("bytes="_s, offset, '-'));
+    // The cache would keep whole videos; libVLC keeps its own window.
+    m_resource = player->mediaResourceLoader()->requestResource(WTF::move(request), PlatformMediaResourceLoader::LoadOption::DisallowCaching);
+    if (!m_resource) {
+        streamEnd(generation, true);
+        return;
+    }
+    m_resource->setClient(WebPornMediaStreamClient::create(m_bridge, generation, offset));
+}
+
+void MediaPlayerPrivateWebPorn::streamResponse(unsigned generation, const ResourceResponse& response)
+{
+    if (generation || m_streamOpened)
+        return;
+    RefPtr player = m_player.get();
+    if (!player)
+        return;
+    uint64_t size = 0;
+    bool seekable = false;
+    if (response.httpStatusCode() == 206) {
+        ParsedContentRange range { response.httpHeaderField(HTTPHeaderName::ContentRange) };
+        if (range.isValid() && range.instanceLength() != ParsedContentRange::unknownLength) {
+            size = range.instanceLength();
+            seekable = true;
+        }
+    } else if (response.expectedContentLength() > 0) {
+        size = response.expectedContentLength();
+        // blob: answers ranges too; a server that ignored this one may not.
+        seekable = response.url().protocolIsBlob() || equalLettersIgnoringASCIICase(response.httpHeaderField(HTTPHeaderName::AcceptRanges), "bytes"_s);
+    }
+    String type = player->contentMIMEType();
+    if (type.isEmpty())
+        type = response.mimeType();
+    m_streamOpened = true;
+    m_library.openStream(m_media, m_url.utf8().data(), type.utf8().data(), size, seekable);
+}
+
+bool MediaPlayerPrivateWebPorn::streamData(unsigned generation, std::span<const uint8_t> bytes)
+{
+    if (generation != m_streamGeneration || !m_streamOpened)
+        return false;
+    m_loadingProgressed = true;
+    return m_library.streamData(m_media, generation, bytes.data(), bytes.size());
+}
+
+void MediaPlayerPrivateWebPorn::streamEnd(unsigned generation, bool failed)
+{
+    if (generation != m_streamGeneration)
+        return;
+    m_resource = nullptr;
+    if (!m_streamOpened) {
+        setNetworkState(MediaPlayer::NetworkState::NetworkError);
+        return;
+    }
+    m_library.streamEnd(m_media, generation, failed);
+}
+
+void WebPornMediaStreamClient::responseReceived(PlatformMediaResource&, const ResourceResponse& response, CompletionHandler<void(ShouldContinuePolicyCheck)>&& completionHandler)
+{
+    int status = response.httpStatusCode();
+    if (status >= 400) {
+        m_stopped = true;
+        completionHandler(ShouldContinuePolicyCheck::No);
+        if (auto* player = m_bridge->player())
+            player->streamEnd(m_generation, true);
+        return;
+    }
+    if (status != 206)
+        m_skip = m_offset;
+    if (auto* player = m_bridge->player())
+        player->streamResponse(m_generation, response);
+    completionHandler(ShouldContinuePolicyCheck::Yes);
+}
+
+void WebPornMediaStreamClient::dataReceived(PlatformMediaResource& resource, const SharedBuffer& buffer)
+{
+    if (m_stopped)
+        return;
+    auto bytes = buffer.span();
+    if (m_skip) {
+        size_t skipped = std::min<uint64_t>(m_skip, bytes.size());
+        m_skip -= skipped;
+        bytes = bytes.subspan(skipped);
+        if (bytes.empty())
+            return;
+    }
+    auto* player = m_bridge->player();
+    if (player && player->streamData(m_generation, bytes))
+        return;
+    // Buffer full or a newer load: libWebPornMedia asks again when it needs more.
+    m_stopped = true;
+    resource.setClient(nullptr);
+    resource.shutdown();
+}
+
+void WebPornMediaStreamClient::accessControlCheckFailed(PlatformMediaResource&, const ResourceError&)
+{
+    m_stopped = true;
+    if (auto* player = m_bridge->player())
+        player->streamEnd(m_generation, true);
+}
+
+void WebPornMediaStreamClient::loadFailed(PlatformMediaResource&, const ResourceError& error)
+{
+    if (m_stopped || error.isCancellation())
+        return;
+    m_stopped = true;
+    if (auto* player = m_bridge->player())
+        player->streamEnd(m_generation, true);
+}
+
+void WebPornMediaStreamClient::loadFinished(PlatformMediaResource&, const NetworkLoadMetrics&)
+{
+    if (m_stopped)
+        return;
+    m_stopped = true;
+    if (auto* player = m_bridge->player())
+        player->streamEnd(m_generation, false);
+}
+
 // MARK: - Callbacks
 
 void MediaPlayerPrivateWebPorn::stateChanged(wpmedia_state state)
