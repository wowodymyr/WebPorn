@@ -0,0 +1,89 @@
+/*
+ * WebPorn: Media Source Extensions over libVLC for jailbroken iOS 8-10.
+ *
+ * SourceBufferPrivate's base class keeps the track buffers (coded frames,
+ * removal, eviction, seeking); what a platform adds is a parser for appended
+ * bytes and a decoder for the samples it enqueues. Here the parser reads
+ * fragmented MP4 (H.264 / AAC), and the enqueued samples of every source buffer
+ * are interleaved into one Matroska stream that libWebPornMedia plays through
+ * its stream input. A seek starts a new stream at the target: libVLC cannot seek
+ * in a stream that is made up as it plays.
+ */
+
+#pragma once
+
+#if defined(WK26_IOS_TARGET) && ENABLE(MEDIA_SOURCE)
+
+#include "MediaSourcePrivate.h"
+#include <span>
+#include <wtf/Logger.h>
+#include <wtf/WeakPtr.h>
+
+namespace WebCore {
+
+class MediaPlayerPrivateInterface;
+class SourceBufferPrivateWebPorn;
+class WebPornMatroskaMuxer;
+struct MediaEngineSupportParameters;
+
+// The player side of a media source: where the Matroska stream goes.
+class WebPornMediaSourceSink : public CanMakeWeakPtr<WebPornMediaSourceSink> {
+public:
+    virtual ~WebPornMediaSourceSink() = default;
+    virtual MediaPlayerPrivateInterface& mediaSourcePlayer() = 0;
+    virtual const Logger& mediaSourceLogger() = 0;
+    // A new stream: the one before it (if any) is dropped.
+    virtual void startMediaSourceStream() = 0;
+    // False: the player's buffer is full; the muxer waits for resumeStream().
+    virtual bool appendMediaSourceStream(std::span<const uint8_t>) = 0;
+    virtual void endMediaSourceStream() = 0;
+    virtual void mediaSourceDurationChanged() = 0;
+    virtual void mediaSourceActiveSourceBuffersChanged() = 0;
+};
+
+class MediaSourcePrivateWebPorn final : public MediaSourcePrivate {
+public:
+    static Ref<MediaSourcePrivateWebPorn> create(WebPornMediaSourceSink&, MediaSourcePrivateClient&);
+    virtual ~MediaSourcePrivateWebPorn();
+
+    // Reuses GStreamer's identity: that port is not built here.
+    constexpr MediaPlatformType platformType() const final { return MediaPlatformType::GStreamer; }
+
+    static bool supportsType(const MediaEngineSupportParameters&, bool& codecsKnown);
+
+    RefPtr<MediaPlayerPrivateInterface> player() const final;
+    void setPlayer(MediaPlayerPrivateInterface*) final;
+    void setSink(WebPornMediaSourceSink*);
+
+    // Before seekToTime(): the next samples start a new stream at this time.
+    void prepareSeek(const MediaTime&);
+    // The player's buffer has room again.
+    void resumeStream();
+
+    WebPornMatroskaMuxer& muxer() { return m_muxer.get(); }
+
+    // From the muxer.
+    void startSinkStream();
+    bool appendToSink(std::span<const uint8_t>);
+    void endSinkStream();
+    const Logger& logger() const { return m_logger.get(); }
+
+private:
+    MediaSourcePrivateWebPorn(WebPornMediaSourceSink&, MediaSourcePrivateClient&);
+
+    AddStatus addSourceBuffer(const ContentType&, const MediaSourceConfiguration&, RefPtr<SourceBufferPrivate>&) final;
+    void durationChanged(const MediaTime&) final;
+    void notifyActiveSourceBuffersChanged() final;
+
+    WeakPtr<WebPornMediaSourceSink> m_sink;
+    const Ref<const Logger> m_logger;
+    const UniqueRef<WebPornMatroskaMuxer> m_muxer;
+};
+
+} // namespace WebCore
+
+SPECIALIZE_TYPE_TRAITS_BEGIN(WebCore::MediaSourcePrivateWebPorn)
+static bool isType(const WebCore::MediaSourcePrivate& mediaSource) { return mediaSource.platformType() == WebCore::MediaPlatformType::GStreamer; }
+SPECIALIZE_TYPE_TRAITS_END()
