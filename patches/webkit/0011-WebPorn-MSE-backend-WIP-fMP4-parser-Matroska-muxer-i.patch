+// MARK: - Fragmented MP4
+
+// Big-endian reads within a box; out-of-range reads give 0 and mark the reader bad.
+class BoxReader {
+public:
+    explicit BoxReader(std::span<const uint8_t> data)
+        : m_data(data)
+    {
+    }
+
+    bool ok() const { return m_ok; }
+    size_t remaining() const { return m_position <= m_data.size() ? m_data.size() - m_position : 0; }
+    size_t position() const { return m_position; }
+    void skip(size_t count) { advance(count); }
+
+    uint8_t u8() { auto bytes = advance(1); return bytes.empty() ? 0 : bytes[0]; }
+    uint16_t u16() { auto bytes = advance(2); return bytes.empty() ? 0 : (bytes[0] << 8) | bytes[1]; }
+    uint32_t u32()
+    {
+        auto bytes = advance(4);
+        return bytes.empty() ? 0 : (uint32_t(bytes[0]) << 24) | (bytes[1] << 16) | (bytes[2] << 8) | bytes[3];
+    }
+    uint64_t u64()
+    {
+        uint64_t high = u32();
+        return (high << 32) | u32();
+    }
+    std::span<const uint8_t> bytes(size_t count) { return advance(count); }
+    std::span<const uint8_t> rest() { return advance(remaining()); }
+
+    // The next child box: its type and payload (after the header).
+    bool nextBox(uint32_t& type, std::span<const uint8_t>& payload)
+    {
+        if (remaining() < 8)
+            return false;
+        size_t start = m_position;
+        uint64_t size = u32();
+        type = u32();
+        if (size == 1)
+            size = u64();
+        else if (!size)
+            size = m_data.size() - start;
+        size_t header = m_position - start;
+        if (size < header || size > m_data.size() - start) {
+            m_ok = false;
+            return false;
+        }
+        payload = m_data.subspan(m_position, size - header);
+        m_position = start + size;
+        return true;
+    }
+
+private:
+    std::span<const uint8_t> advance(size_t count)
+    {
+        if (count > remaining()) {
+            m_ok = false;
+            m_position = m_data.size();
+            return { };
+        }
+        auto result = m_data.subspan(m_position, count);
+        m_position += count;
+        return result;
+    }
+
+    std::span<const uint8_t> m_data;
+    size_t m_position { 0 };
+    bool m_ok { true };
+};
+
+static constexpr uint32_t fourCC(const char (&code)[5])
+{
+    return (uint32_t(uint8_t(code[0])) << 24) | (uint8_t(code[1]) << 16) | (uint8_t(code[2]) << 8) | uint8_t(code[3]);
+}
+
+template<typename Function> static void forEachBox(std::span<const uint8_t> data, Function&& function)
+{
+    BoxReader reader(data);
+    uint32_t type;
+    std::span<const uint8_t> payload;
+    while (reader.nextBox(type, payload))
+        function(type, payload);
+}
+
+static std::optional<std::span<const uint8_t>> findBox(std::span<const uint8_t> data, uint32_t wanted)
+{
+    std::optional<std::span<const uint8_t>> result;
+    forEachBox(data, [&](uint32_t type, std::span<const uint8_t> payload) {
+        if (!result && type == wanted)
+            result = payload;
+    });
+    return result;
+}
+
+// An MPEG-4 descriptor's length (expandable, up to four bytes).
+static uint32_t descriptorLength(BoxReader& reader)
+{
+    uint32_t length = 0;
+    for (int i = 0; i < 4; i++) {
+        uint8_t byte = reader.u8();
+        length = (length << 7) | (byte & 0x7f);
+        if (!(byte & 0x80))
+            break;
+    }
+    return length;
+}
+
+// esds: ES_Descriptor > DecoderConfigDescriptor > DecoderSpecificInfo (the AudioSpecificConfig).
+static Vector<uint8_t> audioSpecificConfig(std::span<const uint8_t> esds)
+{
+    BoxReader reader(esds);
+    reader.skip(4); // version, flags
+    if (reader.u8() != 0x03)
+        return { };
+    descriptorLength(reader);
+    reader.skip(2); // ES_ID
+    uint8_t esFlags = reader.u8();
+    if (esFlags & 0x80)
+        reader.skip(2);
+    if (esFlags & 0x40)
+        reader.skip(reader.u8());
+    if (esFlags & 0x20)
+        reader.skip(2);
+    if (reader.u8() != 0x04)
+        return { };
+    descriptorLength(reader);
+    reader.skip(13); // objectTypeIndication, streamType, bufferSizeDB, maxBitrate, avgBitrate
+    if (reader.u8() != 0x05)
+        return { };
+    auto config = reader.bytes(descriptorLength(reader));
+    return reader.ok() ? Vector<uint8_t>(config) : Vector<uint8_t> { };
+}
+
+// avcC: the NAL length size and the SPS / PPS as length-prefixed NAL units.
+static bool parseAVCConfiguration(std::span<const uint8_t> avcC, WebPornTrackConfig& config)
+{
+    BoxReader reader(avcC);
+    reader.skip(4); // version, profile, compatibility, level
+    config.nalLengthSize = (reader.u8() & 3) + 1;
+    auto appendParameterSet = [&](std::span<const uint8_t> nal) {
+        uint32_t length = nal.size();
+        for (unsigned i = config.nalLengthSize; i; i--)
+            config.parameterSets.append(uint8_t(length >> (8 * (i - 1))));
+        config.parameterSets.append(nal);
+    };
+    unsigned spsCount = reader.u8() & 0x1f;
+    for (unsigned i = 0; i < spsCount; i++)
+        appendParameterSet(reader.bytes(reader.u16()));
+    unsigned ppsCount = reader.u8();
+    for (unsigned i = 0; i < ppsCount; i++)
+        appendParameterSet(reader.bytes(reader.u16()));
+    config.codecPrivate = Vector<uint8_t>(avcC);
+    return reader.ok() && config.nalLengthSize != 3;
+}
+
+struct ParsedTrack {
+    TrackID trackID { 0 };
+    uint32_t timescale { 0 };
+    Ref<WebPornTrackConfig> config { WebPornTrackConfig::create() };
+    // trex defaults
+    uint32_t defaultDuration { 0 };
+    uint32_t defaultSize { 0 };
+    uint32_t defaultFlags { 0 };
+};
+
+static std::optional<ParsedTrack> parseTrack(std::span<const uint8_t> trak)
+{
+    ParsedTrack track;
+    auto tkhd = findBox(trak, fourCC("tkhd"));
+    auto mdia = findBox(trak, fourCC("mdia"));
+    if (!tkhd || !mdia)
+        return std::nullopt;
+    {
+        BoxReader reader(*tkhd);
+        uint8_t version = reader.u8();
+        reader.skip(3 + (version ? 16 : 8));
+        track.trackID = reader.u32();
+    }
+    auto mdhd = findBox(*mdia, fourCC("mdhd"));
+    auto hdlr = findBox(*mdia, fourCC("hdlr"));
+    auto minf = findBox(*mdia, fourCC("minf"));
+    if (!mdhd || !hdlr || !minf)
+        return std::nullopt;
+    {
+        BoxReader reader(*mdhd);
+        uint8_t version = reader.u8();
+        reader.skip(3 + (version ? 16 : 8));
+        track.timescale = reader.u32();
+    }
+    uint32_t handler;
+    {
+        BoxReader reader(*hdlr);
+        reader.skip(8);
+        handler = reader.u32();
+    }
+    auto stbl = findBox(*minf, fourCC("stbl"));
+    auto stsd = stbl ? findBox(*stbl, fourCC("stsd")) : std::nullopt;
+    if (!stsd || !track.timescale)
+        return std::nullopt;
+    BoxReader stsdReader(*stsd);
+    stsdReader.skip(8); // version, flags, entry_count
+    uint32_t format;
+    std::span<const uint8_t> entry;
+    if (!stsdReader.nextBox(format, entry))
+        return std::nullopt;
+    auto& config = track.config.get();
+    if (handler == fourCC("vide") && (format == fourCC("avc1") || format == fourCC("avc3"))) {
+        BoxReader reader(entry);
+        reader.skip(24);
+        config.width = reader.u16();
+        config.height = reader.u16();
+        if (!reader.ok() || entry.size() < 78)
+            return std::nullopt;
+        auto avcC = findBox(entry.subspan(78), fourCC("avcC"));
+        if (!avcC || !parseAVCConfiguration(*avcC, config))
+            return std::nullopt;
+        config.codec = WebPornCodec::H264;
+    } else if (handler == fourCC("soun") && format == fourCC("mp4a")) {
+        BoxReader reader(entry);
+        reader.skip(16);
+        config.channels = reader.u16();
+        reader.skip(6);
+        config.sampleRate = reader.u32() >> 16;
+        if (!reader.ok() || entry.size() < 28)
+            return std::nullopt;
+        auto esds = findBox(entry.subspan(28), fourCC("esds"));
+        if (!esds)
+            return std::nullopt;
+        config.codecPrivate = audioSpecificConfig(*esds);
+        if (config.codecPrivate.isEmpty())
+            return std::nullopt;
+        config.codec = WebPornCodec::AAC;
+    } else
+        return std::nullopt;
+    return track;
+}
