+    size_t m_clusterBlocks { 0 };
+};
+
+static constexpr size_t maximumQueuedSamples = 120;
+
+static void appendEBMLID(Vector<uint8_t>& out, uint32_t id)
+{
+    if (id > 0xffffff)
+        out.append(uint8_t(id >> 24));
+    if (id > 0xffff)
+        out.append(uint8_t(id >> 16));
+    if (id > 0xff)
+        out.append(uint8_t(id >> 8));
+    out.append(uint8_t(id));
+}
+
+static void appendEBMLSize(Vector<uint8_t>& out, uint64_t size)
+{
+    // Always eight bytes: simple, and sizes can be patched in place.
+    out.append(0x01);
+    for (int i = 6; i >= 0; i--)
+        out.append(uint8_t(size >> (8 * i)));
+}
+
+static void appendElement(Vector<uint8_t>& out, uint32_t id, std::span<const uint8_t> payload)
+{
+    appendEBMLID(out, id);
+    appendEBMLSize(out, payload.size());
+    out.append(payload);
+}
+
+static void appendUnsigned(Vector<uint8_t>& out, uint32_t id, uint64_t value)
+{
+    uint8_t bytes[8];
+    int count = 0;
+    do {
+        bytes[7 - count++] = uint8_t(value);
+        value >>= 8;
+    } while (value);
+    appendElement(out, id, std::span { bytes }.last(count));
+}
+
+static void appendFloat(Vector<uint8_t>& out, uint32_t id, double value)
+{
+    uint64_t bits;
+    memcpy(&bits, &value, sizeof(bits));
+    uint8_t bytes[8];
+    for (int i = 0; i < 8; i++)
+        bytes[i] = uint8_t(bits >> (8 * (7 - i)));
+    appendElement(out, id, std::span { bytes });
+}
+
+static void appendString(Vector<uint8_t>& out, uint32_t id, ASCIILiteral value)
+{
+    appendElement(out, id, value.span8());
+}
+
+static void appendMaster(Vector<uint8_t>& out, uint32_t id, NOESCAPE const Function<void(Vector<uint8_t>&)>& children)
+{
+    Vector<uint8_t> payload;
+    children(payload);
+    appendElement(out, id, payload.span());
+}
+
+WebPornMatroskaMuxer::Track* WebPornMatroskaMuxer::track(SourceBufferPrivateWebPorn& owner, TrackID trackID)
+{
+    for (auto& track : m_tracks) {
+        if (track->trackID == trackID && track->owner.get() == &owner)
+            return track.get();
+    }
+    return nullptr;
+}
+
+void WebPornMatroskaMuxer::addTrack(SourceBufferPrivateWebPorn& owner, TrackID trackID, Ref<WebPornTrackConfig>&& config)
+{
+    if (auto* existing = track(owner, trackID)) {
+        // A new initialization segment (another rendition): samples carry their
+        // own configuration from now on.
+        existing->config = WTF::move(config);
+        return;
+    }
+    m_tracks.append(makeUnique<Track>(Track { ThreadSafeWeakPtr { owner }, trackID, unsigned(m_tracks.size() + 1), WTF::move(config), { }, false, false, false }));
+    // A track that appears once the stream runs needs a new stream (new Tracks element).
+    if (m_streamStarted)
+        beginRestart();
+}
+
+void WebPornMatroskaMuxer::beginRestart()
+{
+    if (m_restarting)
+        return;
+    m_restarting = true;
+    m_prerollStart = std::nullopt;
+    m_ended = false;
+    for (auto& track : m_tracks) {
+        track->queue.clear();
+        track->flushedInRestart = false;
+        track->ended = false;
+    }
+    // Tracks that are not flushed by the seek that started this would never send
+    // their samples again: after the source buffers' seek work, re-enqueue those.
+    WorkQueue::mainSingleton().dispatch([weakSource = ThreadSafeWeakPtr { m_mediaSource }] {
+        RefPtr mediaSource = weakSource.get();
+        if (!mediaSource)
+            return;
+        auto& muxer = mediaSource->muxer();
+        if (!muxer.m_restarting)
+            return;
+        for (auto& track : muxer.m_tracks) {
+            if (track->flushedInRestart)
+                continue;
+            track->flushedInRestart = true;
+            if (RefPtr owner = track->owner.get())
+                owner->reenqueue(track->trackID);
+        }
+    });
+}
+
+void WebPornMatroskaMuxer::prepareSeek(const MediaTime& target)
+{
+    m_target = target;
+    beginRestart();
+}
+
+void WebPornMatroskaMuxer::flush(SourceBufferPrivateWebPorn& owner, TrackID trackID)
+{
+    auto* track = this->track(owner, trackID);
+    if (!track)
+        return;
+    if (!m_restarting) {
+        // A flush without a seek (reenqueueMediaIfNeeded after a removal): start
+        // over from the current time.
+        m_target = m_mediaSource.currentTime();
+        beginRestart();
+    }
+    track->queue.clear();
+    track->ended = false;
+    track->flushedInRestart = true;
+}
+
+void WebPornMatroskaMuxer::enqueue(SourceBufferPrivateWebPorn& owner, TrackID trackID, Ref<WebPornMediaSample>&& sample)
+{
+    auto* track = this->track(owner, trackID);
+    if (!track)
+        return;
+    track->ended = false;
+    m_ended = false;
+    track->queue.append(WTF::move(sample));
+    pump();
+}
+
+void WebPornMatroskaMuxer::trackEnded(SourceBufferPrivateWebPorn& owner, TrackID trackID)
+{
+    if (auto* track = this->track(owner, trackID)) {
+        track->ended = true;
+        pump();
+    }
+}
+
+bool WebPornMatroskaMuxer::isReadyForMoreSamples(SourceBufferPrivateWebPorn& owner, TrackID trackID)
+{
+    auto* track = this->track(owner, trackID);
+    return track && !m_blocked && track->queue.size() < maximumQueuedSamples;
+}
+
+void WebPornMatroskaMuxer::notifyWhenReady(SourceBufferPrivateWebPorn& owner, TrackID trackID)
+{
+    if (auto* track = this->track(owner, trackID))
+        track->wantsNotification = true;
+}
+
+void WebPornMatroskaMuxer::resume()
+{
+    if (!m_blocked)
+        return;
+    m_blocked = false;
+    pump();
+}
+
+void WebPornMatroskaMuxer::reset()
+{
+    m_tracks.clear();
+    m_streamStarted = false;
+    m_restarting = false;
+    m_blocked = false;
+    m_ended = false;
+    m_cluster.clear();
+}
+
+void WebPornMatroskaMuxer::notifyReadyTracks()
+{
+    for (auto& track : m_tracks) {
+        if (!track->wantsNotification || m_blocked || track->queue.size() >= maximumQueuedSamples)
+            continue;
+        track->wantsNotification = false;
+        if (RefPtr owner = track->owner.get())
+            owner->readyForMoreSamples(track->trackID);
+    }
+}
+
+void WebPornMatroskaMuxer::startStream()
+{
+    m_mediaSource.startSinkStream();
+    m_streamStarted = true;
+    m_restarting = false;
+    m_cluster.clear();
+    m_clusterBlocks = 0;
+
+    Vector<uint8_t> header;
+    appendMaster(header, 0x1A45DFA3, [](auto& out) {
+        appendUnsigned(out, 0x4286, 1); // EBMLVersion
+        appendUnsigned(out, 0x42F7, 1); // EBMLReadVersion
+        appendUnsigned(out, 0x42F2, 4); // EBMLMaxIDLength
+        appendUnsigned(out, 0x42F3, 8); // EBMLMaxSizeLength
+        appendString(out, 0x4282, "matroska"_s); // DocType
+        appendUnsigned(out, 0x4287, 4); // DocTypeVersion
+        appendUnsigned(out, 0x4285, 2); // DocTypeReadVersion
+    });
+    appendEBMLID(header, 0x18538067); // Segment, unknown size
+    static constexpr uint8_t unknownSize[] = { 0x01, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff };
+    header.append(std::span { unknownSize });
+    appendMaster(header, 0x1549A966, [](auto& out) { // Info
+        appendUnsigned(out, 0x2AD7B1, 1000000); // TimecodeScale: milliseconds
+        appendString(out, 0x4D80, "WebPorn"_s); // MuxingApp
+        appendString(out, 0x5741, "WebPorn"_s); // WritingApp
+    });
+    appendMaster(header, 0x1654AE6B, [&](auto& out) { // Tracks
+        for (auto& track : m_tracks) {
+            auto& config = track->config.get();
+            appendMaster(out, 0xAE, [&](auto& entry) { // TrackEntry
+                appendUnsigned(entry, 0xD7, track->number); // TrackNumber
+                appendUnsigned(entry, 0x73C5, track->number); // TrackUID
+                appendUnsigned(entry, 0x83, config.isVideo() ? 1 : 2); // TrackType
+                appendUnsigned(entry, 0x9C, 0); // FlagLacing
+                appendString(entry, 0x86, config.isVideo() ? "V_MPEG4/ISO/AVC"_s : "A_AAC"_s); // CodecID
+                appendElement(entry, 0x63A2, config.codecPrivate.span()); // CodecPrivate
+                if (config.isVideo()) {
+                    appendMaster(entry, 0xE0, [&](auto& video) {
+                        appendUnsigned(video, 0xB0, config.width);
+                        appendUnsigned(video, 0xBA, config.height);
+                    });
+                } else {
+                    appendMaster(entry, 0xE1, [&](auto& audio) {
+                        appendFloat(audio, 0xB5, config.sampleRate);
+                        appendUnsigned(audio, 0x9F, config.channels);
+                    });
+                }
+            });
+        }
+    });
+    if (!m_mediaSource.appendToSink(header.span()))
+        m_blocked = true;
+}
+
+static int64_t milliseconds(const MediaTime& time)
+{
+    return std::max<int64_t>(0, llround(time.toDouble() * 1000));
+}
+
+void WebPornMatroskaMuxer::writeBlock(Track& track, WebPornMediaSample& sample)
+{
+    auto presentationTime = sample.presentationTime();
+    if (sample.flags() & MediaSample::IsNonDisplaying) {
+        // Decode, do not show: Matroska has no such flag that libVLC honors, so
+        // these frames (from the key frame to the seek target) are squeezed into
+        // the last 50 ms before the target, in their order.
+        if (!m_prerollStart)
+            m_prerollStart = presentationTime;
+        auto span = m_target - *m_prerollStart;
+        auto behind = m_target - presentationTime;
+        double fraction = span > MediaTime::zeroTime() ? std::clamp(behind.toDouble() / span.toDouble(), 0.0, 1.0) : 0;
+        presentationTime = m_target - MediaTime::createWithDouble(0.002 + 0.048 * fraction);
+    }
+    int64_t time = milliseconds(presentationTime);
+    if (m_clusterBlocks && (time - m_clusterTime > 30000 || time - m_clusterTime < -30000))
+        flushCluster();
+    if (!m_clusterBlocks)
+        m_clusterTime = time;
+    int16_t relative = int16_t(time - m_clusterTime);
+
+    auto& config = sample.config();
+    bool prependParameterSets = config.isVideo() && (sample.flags() & MediaSample::IsSync) && !config.parameterSets.isEmpty();
+    auto data = sample.data();
+    uint64_t blockSize = 4 + data.size() + (prependParameterSets ? config.parameterSets.size() : 0);
+    appendEBMLID(m_cluster, 0xA3); // SimpleBlock
+    appendEBMLSize(m_cluster, blockSize);
+    m_cluster.append(uint8_t(0x80 | track.number)); // track number as a one-byte vint
+    m_cluster.append(uint8_t(uint16_t(relative) >> 8));
+    m_cluster.append(uint8_t(relative));
+    m_cluster.append(uint8_t(sample.flags() & MediaSample::IsSync ? 0x80 : 0x00));
+    if (prependParameterSets)
+        m_cluster.append(config.parameterSets.span());
+    m_cluster.append(data);
+    m_clusterBlocks++;
+}
+
+bool WebPornMatroskaMuxer::flushCluster()
+{
+    if (!m_clusterBlocks)
+        return true;
+    Vector<uint8_t> cluster;
+    appendEBMLID(cluster, 0x1F43B675);
+    Vector<uint8_t> timecode;
+    appendUnsigned(timecode, 0xE7, m_clusterTime);
+    appendEBMLSize(cluster, timecode.size() + m_cluster.size());
+    cluster.append(timecode.span());
+    cluster.append(m_cluster.span());
+    m_cluster.clear();
+    m_clusterBlocks = 0;
+    return m_mediaSource.appendToSink(cluster.span());
+}
+
+void WebPornMatroskaMuxer::pump()
+{
+    if (m_pumping || m_blocked || m_tracks.isEmpty())
+        return;
+    SetForScope pumping(m_pumping, true);
+    for (;;) {
+        Track* next = nullptr;
+        bool waiting = false;
+        for (auto& track : m_tracks) {
+            if (track->queue.isEmpty()) {
+                if (!track->ended)
+                    waiting = true;
+                continue;
+            }
+            if (!next || track->queue.first()->decodeTime() < next->queue.first()->decodeTime())
+                next = track.get();
+        }
+        // Every track must have its next sample (or be done) to keep the order.
+        if (waiting || !next)
+            break;
+        if (!m_streamStarted || m_restarting) {
+            startStream();
+            if (m_blocked)
+                break;
+        }
+        Ref sample = next->queue.takeFirst();
+        bool drop = (sample->flags() & MediaSample::IsNonDisplaying) && !next->config->isVideo();
+        if (!drop)
+            writeBlock(*next, sample);
+        if (m_clusterBlocks >= 32 && !flushCluster()) {
+            m_blocked = true;
+            break;
+        }
+    }
+    if (!m_blocked && !flushCluster())
+        m_blocked = true;
+    bool allEnded = !m_tracks.isEmpty() && std::ranges::all_of(m_tracks, [](auto& track) { return track->ended && track->queue.isEmpty(); });
+    if (allEnded && m_streamStarted && !m_restarting && !m_ended && !m_blocked) {
+        m_ended = true;
+        m_mediaSource.endSinkStream();
+    }
+    notifyReadyTracks();
+}
