+
+private:
+    struct Track {
+        ThreadSafeWeakPtr<SourceBufferPrivateWebPorn> owner;
+        TrackID trackID { 0 };
+        unsigned number { 0 }; // Matroska track number
+        Ref<WebPornTrackConfig> config;
