+
+Ref<MediaPromise> SourceBufferPrivateWebPorn::appendInternal(Ref<SharedBuffer>&& data)
+{
+    m_input.append(data->span());
+    size_t consumed = 0;
+    BoxReader reader(m_input.span());
+    for (;;) {
+        size_t start = reader.position();
+        uint32_t type;
+        std::span<const uint8_t> payload;
+        // Only whole boxes: an incomplete one waits for the next append.
+        if (reader.remaining() < 8)
+            break;
+        uint64_t size = (uint64_t(m_input[start]) << 24) | (m_input[start + 1] << 16) | (m_input[start + 2] << 8) | m_input[start + 3];
+        if (size == 1) {
+            if (reader.remaining() < 16)
+                break;
+            size = 0;
+            for (int i = 8; i < 16; i++)
+                size = (size << 8) | m_input[start + i];
+        }
+        if (size < 8) {
+            m_input.clear();
+            return MediaPromise::createAndReject(PlatformMediaError::ParsingError);
+        }
+        if (size > reader.remaining())
+            break;
+        if (!reader.nextBox(type, payload))
+            break;
+        uint64_t offset = m_inputOffset + start;
+        bool ok = true;
+        if (type == fourCC("moov"))
+            ok = parseInitialization(payload);
+        else if (type == fourCC("moof")) {
+            m_moof = Vector<uint8_t>(payload);
+            m_moofOffset = offset;
+        } else if (type == fourCC("mdat")) {
+            if (!m_moof.isEmpty())
+                ok = parseFragment(m_moof.span(), m_moofOffset, payload, offset + (size - payload.size()));
+            m_moof.clear();
+        }
+        if (!ok) {
+            m_input.clear();
+            return MediaPromise::createAndReject(PlatformMediaError::ParsingError);
+        }
+        consumed = reader.position();
+    }
+    if (consumed) {
+        m_input.removeAt(0, consumed);
+        m_inputOffset += consumed;
+    }
+    return MediaPromise::createAndResolve();
+}
+
+bool SourceBufferPrivateWebPorn::parseInitialization(std::span<const uint8_t> moov)
+{
+    InitializationSegment segment;
+    Vector<ParsedTrack> tracks;
+    uint64_t duration = 0;
+    uint32_t movieTimescale = 0;
+    forEachBox(moov, [&](uint32_t type, std::span<const uint8_t> payload) {
+        if (type == fourCC("mvhd")) {
+            BoxReader reader(payload);
+            uint8_t version = reader.u8();
+            reader.skip(3 + (version ? 16 : 8));
+            movieTimescale = reader.u32();
+            duration = version ? reader.u64() : reader.u32();
+        } else if (type == fourCC("trak")) {
+            if (auto track = parseTrack(payload))
+                tracks.append(WTF::move(*track));
+        } else if (type == fourCC("mvex")) {
+            forEachBox(payload, [&](uint32_t type, std::span<const uint8_t> payload) {
+                if (type == fourCC("mehd")) {
+                    BoxReader reader(payload);
+                    uint8_t version = reader.u8();
+                    reader.skip(3);
+                    duration = version ? reader.u64() : reader.u32();
+                } else if (type == fourCC("trex")) {
+                    BoxReader reader(payload);
+                    reader.skip(4);
+                    TrackID trackID = reader.u32();
+                    reader.skip(4); // default_sample_description_index
+                    for (auto& track : tracks) {
+                        if (track.trackID != trackID)
+                            continue;
+                        track.defaultDuration = reader.u32();
+                        track.defaultSize = reader.u32();
+                        track.defaultFlags = reader.u32();
+                    }
+                }
+            });
+        }
+    });
+    if (tracks.isEmpty())
+        return false;
+    segment.duration = duration && movieTimescale && duration != 0xffffffff && duration != UINT64_MAX ? MediaTime(duration, movieTimescale) : MediaTime::zeroTime();
+    RefPtr mediaSource = mediaSourcePrivate();
+    for (auto& track : tracks) {
+        if (track.config->isVideo())
+            segment.videoTracks.append({ WebPornMediaDescription::create(track.config.get()), WebPornVideoTrackPrivate::create(track.trackID) });
+        else
+            segment.audioTracks.append({ WebPornMediaDescription::create(track.config.get()), WebPornAudioTrackPrivate::create(track.trackID) });
+        if (mediaSource)
+            mediaSource->muxer().addTrack(*this, track.trackID, track.config.copyRef());
+    }
+    m_tracks = WTF::move(tracks);
+    didReceiveInitializationSegment(WTF::move(segment));
+    return true;
+}
+
+bool SourceBufferPrivateWebPorn::parseFragment(std::span<const uint8_t> moof, uint64_t moofOffset, std::span<const uint8_t> mdat, uint64_t mdatOffset)
+{
+    bool ok = true;
+    forEachBox(moof, [&](uint32_t type, std::span<const uint8_t> traf) {
+        if (type != fourCC("traf") || !ok)
+            return;
+        auto tfhd = findBox(traf, fourCC("tfhd"));
+        if (!tfhd)
+            return;
+        BoxReader header(*tfhd);
+        uint32_t tfhdFlags = header.u32() & 0xffffff;
+        TrackID trackID = header.u32();
+        ParsedTrack* track = nullptr;
+        for (auto& candidate : m_tracks) {
+            if (candidate.trackID == trackID)
+                track = &candidate;
+        }
+        if (!track)
+            return;
+        uint64_t baseOffset = moofOffset;
+        if (tfhdFlags & 0x1)
+            baseOffset = header.u64();
+        if (tfhdFlags & 0x2)
+            header.skip(4);
+        uint32_t defaultDuration = tfhdFlags & 0x8 ? header.u32() : track->defaultDuration;
+        uint32_t defaultSize = tfhdFlags & 0x10 ? header.u32() : track->defaultSize;
+        uint32_t defaultFlags = tfhdFlags & 0x20 ? header.u32() : track->defaultFlags;
+        uint64_t decodeTime = 0;
+        if (auto tfdt = findBox(traf, fourCC("tfdt"))) {
+            BoxReader reader(*tfdt);
+            decodeTime = reader.u8() ? (reader.skip(3), reader.u64()) : (reader.skip(3), uint64_t(reader.u32()));
+        }
+        uint64_t dataPosition = baseOffset;
+        forEachBox(traf, [&](uint32_t type, std::span<const uint8_t> trun) {
+            if (type != fourCC("trun") || !ok)
+                return;
+            BoxReader reader(trun);
+            uint32_t versionAndFlags = reader.u32();
+            uint8_t version = versionAndFlags >> 24;
+            uint32_t flags = versionAndFlags & 0xffffff;
+            uint32_t count = reader.u32();
+            if (flags & 0x1)
+                dataPosition = baseOffset + int32_t(reader.u32());
+            std::optional<uint32_t> firstSampleFlags;
+            if (flags & 0x4)
+                firstSampleFlags = reader.u32();
+            for (uint32_t i = 0; i < count && reader.ok(); i++) {
+                uint32_t duration = flags & 0x100 ? reader.u32() : defaultDuration;
+                uint32_t size = flags & 0x200 ? reader.u32() : defaultSize;
+                uint32_t sampleFlags = flags & 0x400 ? reader.u32() : (!i && firstSampleFlags ? *firstSampleFlags : defaultFlags);
+                if (!i && firstSampleFlags && (flags & 0x400))
+                    sampleFlags = *firstSampleFlags;
+                int64_t compositionOffset = 0;
+                if (flags & 0x800)
+                    compositionOffset = version ? int64_t(int32_t(reader.u32())) : int64_t(reader.u32());
+                if (dataPosition < mdatOffset || dataPosition + size > mdatOffset + mdat.size()) {
+                    ok = false;
+                    return;
+                }
+                auto bytes = mdat.subspan(dataPosition - mdatOffset, size);
+                dataPosition += size;
+                bool isSync = !track->config->isVideo() || !(sampleFlags & 0x10000);
+                auto sample = WebPornMediaSample::create(trackID, MediaTime(int64_t(decodeTime) + compositionOffset, track->timescale),
+                    MediaTime(decodeTime, track->timescale), MediaTime(duration, track->timescale), isSync, Vector<uint8_t>(bytes), track->config.copyRef());
+                decodeTime += duration;
+                didReceiveSample(WTF::move(sample));
+            }
+            if (!reader.ok())
+                ok = false;
+        });
+    });
+    return ok;
+}
+
