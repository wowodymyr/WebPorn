+    WTF_MAKE_TZONE_ALLOCATED_INLINE(WebPornMatroskaMuxer);
+public:
+    // Owned by the media source.
+    explicit WebPornMatroskaMuxer(MediaSourcePrivateWebPorn& mediaSource)
+        : m_mediaSource(mediaSource)
+    {
+    }
