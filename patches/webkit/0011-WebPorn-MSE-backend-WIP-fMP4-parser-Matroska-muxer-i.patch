+bool MediaSourcePrivateWebPorn::supportsType(const MediaEngineSupportParameters& parameters, bool& codecsKnown)
+{
+    codecsKnown = false;
+    auto container = parameters.type.containerType().convertToASCIILowercase();
+    bool video = container == "video/mp4"_s;
+    if (!video && container != "audio/mp4"_s)
+        return false;
+    auto codecs = parameters.type.codecs();
+    for (auto& codec : codecs) {
+        auto name = codec.trim(isASCIIWhitespace<char16_t>).convertToASCIILowercase();
+        bool isVideoCodec = name.startsWith("avc1"_s) || name.startsWith("avc3"_s);
+        bool isAudioCodec = name.startsWith("mp4a"_s);
+        if (!(isAudioCodec || (video && isVideoCodec)))
+            return false;
+    }
+    codecsKnown = !codecs.isEmpty();
+    return true;
+}
