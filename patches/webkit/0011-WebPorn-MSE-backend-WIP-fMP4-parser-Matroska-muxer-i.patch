+
+MediaSourcePrivate::AddStatus MediaSourcePrivateWebPorn::addSourceBuffer(const ContentType& type, const MediaSourceConfiguration&, RefPtr<SourceBufferPrivate>& sourceBuffer)
+{
+    MediaEngineSupportParameters parameters;
+    parameters.isMediaSource = true;
+    parameters.type = type;
+    bool codecsKnown;
+    if (!supportsType(parameters, codecsKnown))
+        return AddStatus::NotSupported;
+    {
+        Locker locker { m_lock };
+        m_sourceBuffers.append(SourceBufferPrivateWebPorn::create(*this));
+        sourceBuffer = m_sourceBuffers.last();
+    }
+    sourceBuffer->setMediaSourceDuration(duration());
+    return AddStatus::Ok;
+}
