@@ -45,6 +50,14 @@ struct DispatchWorkItem {
 template<typename T> static void dispatchWorkItem(void* dispatchContext)
 {
     T* item = reinterpret_cast<T*>(dispatchContext);
+#if USE(WEB_THREAD) && defined(WK26_IOS_TARGET)
+    // WebPorn: WorkQueue::mainSingleton() is the UI thread's queue, but WebKit1 runs
+    // WebCore on the WebThread; MSE (SourceBufferPrivate, MediaSourcePrivate) and
+    // NativePromise users post WebCore work here. Run it under the web lock, as
+    // RunLoop::performWork does on the main run loop.
+    if (pthread_main_np() && WebCoreWebThreadIsEnabled && WebCoreWebThreadIsEnabled())
+        WebCoreWebThreadLock();
+#endif
     (*item)();
     delete item;
 }
