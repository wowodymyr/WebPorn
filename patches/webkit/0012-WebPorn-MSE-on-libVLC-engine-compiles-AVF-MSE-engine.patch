+bool SourceBufferPrivateWebPorn::parseInitialization(std::span<const uint8_t> moov)
+{
+    InitializationSegment segment;
+    Vector<ParsedTrack> tracks;
+    uint64_t duration = 0;
+    uint32_t movieTimescale = 0;
+    forEachBox(moov, [&](uint32_t type, std::span<const uint8_t> payload) {
+        if (type == fourCC("mvhd")) {
+            BoxReader reader(payload);
+            uint8_t version = reader.u8();
+            reader.skip(3 + (version ? 16 : 8));
+            movieTimescale = reader.u32();
+            duration = version ? reader.u64() : reader.u32();
+        } else if (type == fourCC("trak")) {
+            if (auto track = parseTrack(payload))
+                tracks.append(WTF::move(*track));
+        } else if (type == fourCC("mvex")) {
+            forEachBox(payload, [&](uint32_t type, std::span<const uint8_t> payload) {
+                if (type == fourCC("mehd")) {
+                    BoxReader reader(payload);
+                    uint8_t version = reader.u8();
+                    reader.skip(3);
+                    duration = version ? reader.u64() : reader.u32();
+                } else if (type == fourCC("trex")) {
+                    BoxReader reader(payload);
+                    reader.skip(4);
+                    TrackID trackID = reader.u32();
+                    reader.skip(4); // default_sample_description_index
+                    for (auto& track : tracks) {
+                        if (track.trackID != trackID)
+                            continue;
+                        track.defaultDuration = reader.u32();
+                        track.defaultSize = reader.u32();
+                        track.defaultFlags = reader.u32();
+                    }
+                }
+            });
+        }
+    });
+    if (tracks.isEmpty())
+        return false;
+    segment.duration = duration && movieTimescale && duration != 0xffffffff && duration != UINT64_MAX ? MediaTime(duration, movieTimescale) : MediaTime::zeroTime();
+    RefPtr mediaSource = mediaSourcePrivate();
+    for (auto& track : tracks) {
+        if (track.config->isVideo())
+            segment.videoTracks.append({ WebPornMediaDescription::create(track.config.get()), WebPornVideoTrackPrivate::create(track.trackID) });
+        else
+            segment.audioTracks.append({ WebPornMediaDescription::create(track.config.get()), WebPornAudioTrackPrivate::create(track.trackID) });
+        if (mediaSource)
+            mediaSource->muxer().addTrack(*this, track.trackID, track.config.copyRef());
+    }
+    m_tracks = WTF::move(tracks);
+    didReceiveInitializationSegment(WTF::move(segment));
+    return true;
+}
