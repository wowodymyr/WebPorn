+bool WebPornMatroskaMuxer::allSourceBuffersHaveTracks() const
+{
+    for (auto& sourceBuffer : m_mediaSource.sourceBuffers()) {
+        bool hasTrack = std::ranges::any_of(m_tracks, [&](auto& track) {
+            RefPtr owner = track->owner.get();
+            return owner.get() == sourceBuffer.ptr();
+        });
+        if (!hasTrack)
+            return false;
+    }
+    return true;
+}
