 namespace WebCore {
 
+// /var/webporn/wpmedia-debug present: muxer decisions to mse.log.
+static void mseLog(const char* format, ...) WTF_ATTRIBUTE_PRINTF(1, 2);
+static void mseLog(const char* format, ...)
+{
+    static FILE* file;
+    static std::once_flag once;
+    static MonotonicTime start;
+    std::call_once(once, [] {
+        start = MonotonicTime::now();
+        if (!access("/var/webporn/wpmedia-debug", F_OK))
+            file = fopen("/var/mobile/Media/webporn/mse.log", "w");
+    });
+    if (!file)
+        return;
+    fprintf(file, "%7.3f ", (MonotonicTime::now() - start).seconds());
+    va_list args;
+    va_start(args, format);
+    vfprintf(file, format, args);
+    va_end(args);
+    fputc('\n', file);
+    fflush(file);
+}
