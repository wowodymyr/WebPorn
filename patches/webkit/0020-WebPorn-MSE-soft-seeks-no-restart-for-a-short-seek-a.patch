+#if defined(WK26_IOS_TARGET)
+#include <mutex>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+// WebPorn: with /var/webporn/console-log present, every console message and
+// uncaught exception goes to /var/mobile/Media/webporn/console-<process>.log
+// (UIWebView and Safari show them nowhere).
+static void logConsoleMessage(MessageLevel level, const String& message, unsigned lineNumber, const String& sourceURL)
+{
+    static FILE* file;
+    static std::once_flag once;
+    std::call_once(once, [] {
+        if (access("/var/webporn/console-log", F_OK))
+            return;
+        char path[256];
+        snprintf(path, sizeof(path), "/var/mobile/Media/webporn/console-%s.log", getprogname());
+        file = fopen(path, "w");
+    });
+    if (!file)
+        return;
+    static constexpr const char* levels[] = { "log", "warning", "error", "debug", "info" };
+    unsigned index = static_cast<unsigned>(level);
+    fprintf(file, "[%s] %s (%s:%u)\n", index < std::size(levels) ? levels[index] : "?", message.utf8().data(), sourceURL.utf8().data(), lineNumber);
+    fflush(file);
+}
+#endif
+
 void WebChromeClient::addMessageToConsole(MessageSource source, MessageLevel level, const String& message, unsigned lineNumber, unsigned columnNumber, const String& sourceURL)
 {
+#if defined(WK26_IOS_TARGET)
+    logConsoleMessage(level, message, lineNumber, sourceURL);
+#endif
