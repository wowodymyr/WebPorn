-void WebPornMatroskaMuxer::prepareSeek(const MediaTime& target)
+bool WebPornMatroskaMuxer::prepareSeek(const MediaTime& target)
 {
+    // A seek a little ahead of where playback is, into what the stream already
+    // holds (hls.js seeks to where its buffer starts, and nudges the playhead by
+    // tenths of a second): restarting would cost a second or more (more than
+    // two before the first frame, when the video output is still being set up),
+    // long enough for players to see a stall and seek again.
+    if (m_streamStarted && !m_restarting && m_streamStart) {
+        double played = std::max(m_mediaSource.playedTime(), m_streamStart->toDouble());
+        double ahead = target.toDouble() - played;
+        if (ahead >= -0.05 && ahead <= 1.5 && target <= m_writtenThrough + MediaTime::createWithDouble(0.5)) {
+            mseLog("soft seek to %.3f (played %.3f, written through %.3f)", target.toDouble(), played, m_writtenThrough.toDouble());
+            // Each track's flush for this seek (it comes later, from the source
+            // buffer's own queue) keeps the stream going.
+            for (auto& track : m_tracks)
+                track->softFlushPending = true;
+            return false;
+        }
+    }
+    for (auto& track : m_tracks)
+        track->softFlushPending = false;
     m_target = target;
     beginRestart();
+    return true;
 }
 
