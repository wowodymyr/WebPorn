+// Debug: the first bytes appended to each source buffer, sourcebuffer-<n>.mp4.
+static void dumpAppend(FILE*& file, size_t& dumped, std::span<const uint8_t> bytes)
+{
+    static unsigned count;
+    if (!file && !dumped && !access("/var/webporn/wpmedia-debug", F_OK)) {
+        char path[128];
+        snprintf(path, sizeof(path), "/var/mobile/Media/webporn/sourcebuffer-%u.mp4", count++ % 4);
+        file = fopen(path, "w");
+    }
+    if (!file)
+        return;
+    size_t length = std::min(bytes.size(), size_t(4 << 20) - dumped);
+    fwrite(bytes.data(), 1, length, file);
+    fflush(file);
+    dumped += length;
+    if (dumped >= size_t(4 << 20)) {
+        fclose(file);
+        file = nullptr;
+    }
+}
