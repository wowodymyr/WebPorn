         m_mediaSource->setSink(nullptr);
 #endif
     stopStreamLoad();
+    for (auto& resource : m_fetches.values()) {
+        resource->setClient(nullptr);
+        resource->shutdown();
+    }
     m_bridge->detach();
     // No callback runs after destroy returns; queued ones find the bridge detached.
     if (m_media)
@@ -412,9 +463,88 @@ void MediaPlayerPrivateWebPorn::load(const String& url)
         startStreamLoad(0, 0);
         return;
     }
+    // HLS (libVLC's adaptive demuxer fetches by itself): through the proxy, so
+    // that playlists, segments and keys come from the page's loader.
+    static bool direct = !access("/var/webporn/media-direct", F_OK);
+    char proxied[8192];
+    URL parsed { url };
+    if (!direct && parsed.protocolIsInHTTPFamily() && m_library.proxyURL(m_media, url.utf8().data(), proxied, sizeof(proxied))) {
+        m_library.open(m_media, proxied, player->contentMIMEType().utf8().data(), nullptr, nullptr);
+        return;
+    }
     m_library.open(m_media, url.utf8().data(), player->contentMIMEType().utf8().data(), player->userAgent().utf8().data(), player->referrer().utf8().data());
 }
 
+void MediaPlayerPrivateWebPorn::startFetch(unsigned id, const String& url, const String& range)
+{
+    RefPtr player = m_player.get();
+    if (!player || !m_media) {
+        m_library.fetchEnd(m_media, id, 1);
+        return;
+    }
+    ResourceRequest request { URL { url } };
+    if (!range.isEmpty())
+        request.setHTTPHeaderField(HTTPHeaderName::Range, range);
+    RefPtr resource = player->mediaResourceLoader()->requestResource(WTF::move(request), PlatformMediaResourceLoader::LoadOption::DisallowCaching);
+    if (!resource) {
+        m_library.fetchEnd(m_media, id, 1);
+        return;
+    }
+    resource->setClient(WebPornProxyFetchClient::create(m_bridge, id));
+    m_fetches.set(id, WTF::move(resource));
+}
+
+void MediaPlayerPrivateWebPorn::cancelFetch(unsigned id)
+{
+    if (RefPtr resource = m_fetches.take(id)) {
+        resource->setClient(nullptr);
+        resource->shutdown();
+    }
+}
+
+void MediaPlayerPrivateWebPorn::fetchResponse(unsigned id, const ResourceResponse& response)
+{
+    String contentRange = response.httpHeaderField(HTTPHeaderName::ContentRange);
+    long long length = response.expectedContentLength() >= 0 ? response.expectedContentLength() : -1;
+    m_library.fetchResponse(m_media, id, response.httpStatusCode() ? response.httpStatusCode() : 200, length, response.mimeType().utf8().data(), contentRange.isEmpty() ? nullptr : contentRange.utf8().data());
+}
+
+void MediaPlayerPrivateWebPorn::fetchData(unsigned id, std::span<const uint8_t> bytes)
+{
+    m_loadingProgressed = true;
+    m_library.fetchData(m_media, id, bytes.data(), bytes.size());
+}
+
+void MediaPlayerPrivateWebPorn::fetchEnd(unsigned id, bool failed)
+{
+    m_fetches.remove(id);
+    m_library.fetchEnd(m_media, id, failed);
+}
+
+void WebPornProxyFetchClient::responseReceived(PlatformMediaResource&, const ResourceResponse& response, CompletionHandler<void(ShouldContinuePolicyCheck)>&& completionHandler)
+{
+    if (auto* player = m_bridge->player())
+        player->fetchResponse(m_id, response);
+    completionHandler(ShouldContinuePolicyCheck::Yes);
+}
+
+void WebPornProxyFetchClient::dataReceived(PlatformMediaResource&, const SharedBuffer& buffer)
+{
+    if (m_finished)
+        return;
+    if (auto* player = m_bridge->player())
+        player->fetchData(m_id, buffer.span());
+}
+
+void WebPornProxyFetchClient::finish(bool failed)
+{
+    if (m_finished)
+        return;
+    m_finished = true;
+    if (auto* player = m_bridge->player())
+        player->fetchEnd(m_id, failed);
+}
+
 void MediaPlayerPrivateWebPorn::cancelLoad()
 {
     stopStreamLoad();
