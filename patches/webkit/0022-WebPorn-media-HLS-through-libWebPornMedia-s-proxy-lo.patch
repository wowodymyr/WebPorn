+// One request of libWebPornMedia's proxy (what libVLC fetches for HLS), loaded
+// by the page's loader.
+class WebPornProxyFetchClient final : public PlatformMediaResourceClient {
+public:
+    static Ref<WebPornProxyFetchClient> create(WebPornMediaBridge& bridge, unsigned id) { return adoptRef(*new WebPornProxyFetchClient(bridge, id)); }
+
+private:
+    WebPornProxyFetchClient(WebPornMediaBridge& bridge, unsigned id)
+        : m_bridge(bridge)
+        , m_id(id)
+    {
+    }
+
+    void responseReceived(PlatformMediaResource&, const ResourceResponse&, CompletionHandler<void(ShouldContinuePolicyCheck)>&&) final;
+    void dataReceived(PlatformMediaResource&, const SharedBuffer&) final;
+    void accessControlCheckFailed(PlatformMediaResource&, const ResourceError&) final { finish(true); }
+    void loadFailed(PlatformMediaResource&, const ResourceError&) final { finish(true); }
+    void loadFinished(PlatformMediaResource&, const NetworkLoadMetrics&) final { finish(false); }
+    void finish(bool failed);
+
+    Ref<WebPornMediaBridge> m_bridge;
+    unsigned m_id;
+    bool m_finished { false };
+};
