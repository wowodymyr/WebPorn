+    CheckedPtr<RenderObject> renderer = startNode.renderer();
+    for (; renderer; renderer = renderer->parent()) {
+        CheckedPtr renderBox = dynamicDowncast<RenderBox>(renderer.get());
+        if (renderBox && renderBox->canBeScrolledAndHasScrollableArea())
+            break;
+    }
+    if (!renderer)
+        return;
+
+    CheckedPtr layerModelObject = dynamicDowncast<RenderLayerModelObject>(renderer.get());
+    if (!layerModelObject || !layerModelObject->layer())
+        return;
+    auto* scrollableArea = layerModelObject->layer()->scrollableArea();
+    if (!scrollableArea)
+        return;
+
+    SyntheticPlatformTouchEvent platformEvent(platformTypeForTouchEvent(touchEvent), WTF::move(points));
+    if (scrollableArea->scrollAnimator().handleTouchEvent(platformEvent))
+        touchEvent.setDefaultHandled();
+}
