+#if !HAVE(DYLD_GET_DLOPEN_IMAGE_HEADER)
+// WK26: _dyld_get_dlopen_image_header() is iOS 15+; find the loaded image whose path
+// matches the install name instead.
+static const struct mach_header *wk26ImageHeaderForInstallName(const String& installName)
+{
+    auto utf8 = installName.utf8();
+    const char* wanted = utf8.data();
+    size_t wantedLength = utf8.length();
+    uint32_t count = _dyld_image_count();
+    for (uint32_t i = 0; i < count; ++i) {
+        const char* name = _dyld_get_image_name(i);
+        if (!name)
+            continue;
+        size_t nameLength = strlen(name);
+        if (nameLength < wantedLength)
+            continue;
+        // Match the whole path or a trailing path component only.
+        if (memcmp(name + nameLength - wantedLength, wanted, wantedLength))
+            continue;
+        if (nameLength != wantedLength && wanted[0] != '/' && name[nameLength - wantedLength - 1] != '/')
+            continue;
+        return _dyld_get_image_header(i);
+    }
+    return nullptr;
+}
+#endif
+
 void LibraryPathDiagnosticsLogger::logDynamicLibraryInfo(const String& installName)
 {
     void *handle = dlopen(installName.utf8().data(), RTLD_NOLOAD);
     if (!handle)
         return;
 
+#if HAVE(DYLD_GET_DLOPEN_IMAGE_HEADER)
     const struct mach_header *header = _dyld_get_dlopen_image_header(handle);
+#else
+    const struct mach_header *header = wk26ImageHeaderForInstallName(installName);
+#endif
     if (!header) {
         logError("Unable to locate mach header for %s", installName.utf8().data());
         return;
