+/*
+ * WK26: a persistent on-disk JSC bytecode cache for WebKitLegacy, which has no
+ * disk cache of its own. Files are keyed by script content and written via
+ * temp + rename on a work queue; hits are mmap'd and bounded by an LRU sweep.
+ */
+
+#include "config.h"
+#include <notify.h>
+#include "CachedScriptSourceProvider.h"
+
+#include <JavaScriptCore/BytecodeCacheError.h>
+#include <JavaScriptCore/CachedBytecode.h>
+#include <JavaScriptCore/CachedTypes.h>
+#include <JavaScriptCore/JSCBytecodeCacheVersion.h>
+#include <JavaScriptCore/JSCInlines.h>
+#include <JavaScriptCore/UnlinkedFunctionExecutable.h>
+#include <atomic>
+#include <dirent.h>
+#include <fcntl.h>
+#include <mach/mach.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/time.h>
+#include <unistd.h>
+#include <wtf/FileHandle.h>
+#include <wtf/FileSystem.h>
+#include <wtf/MappedFileData.h>
+#include <wtf/NeverDestroyed.h>
+#include <wtf/StdLibExtras.h>
+#include <wtf/TZoneMallocInlines.h>
+#include <wtf/Vector.h>
+#include <wtf/WorkQueue.h>
+#include <wtf/HashMap.h>
+#include <wtf/HexNumber.h>
+#include <wtf/URL.h>
+#include <wtf/text/MakeString.h>
+#include <wtf/text/StringBuilder.h>
+
+namespace WebCore {
+
+namespace {
+
+constexpr bool wk26BytecodeCacheDefaultOn = true;
+// Per-process overrides, read once: WK26_BYTECODE_DIR, WK26_BYTECODE_HOSTS
+// (host suffixes), WK26_BYTECODE_MINLEN (bytes), WK26_BYTECODE_HIGHWATER (MB).
+constexpr size_t wk26DefaultMinSourceLength = 16 * 1024;
+// Mapped pages are clean and evictable, so this bounds flash, not RAM.
+constexpr uint64_t wk26DefaultDirectoryHighWater = 96u * 1024 * 1024;
+
+// WK26_BYTECODE_FULL=1: compile and encode whole scripts (every nested function)
+// so later launches decode everything instead of parsing.
+static bool wk26BytecodeFullMode()
+{
+    static const bool value = [] {
+        const char* env = getenv("WK26_BYTECODE_FULL");
+        return env && *env && *env != '0';
+    }();
+    return value;
+}
+
+// WK26_BYTECODE_FULL_FIRST=1: compile whole on first sight, not on a recurrence.
+static bool wk26BytecodeFullFirst()
+{
+    static const bool value = [] {
+        const char* env = getenv("WK26_BYTECODE_FULL_FIRST");
+        return env && *env && *env != '0';
+    }();
+    return value;
+}
+
+// Larger scripts are never compiled whole (the eager compile can exhaust memory);
+// they use the two-visit path instead.
+constexpr size_t wk26FullMaxLength = 2 * 1024 * 1024;
+// Prior sightings a key needs before it is compiled whole.
+constexpr unsigned wk26FullAfter = 1;
+
+// With WK26_BYTECODE_HOSTS set, only scripts from those hosts use the store.
+static bool wk26HostEligible(const String& sourceURL)
+{
+    static const Vector<String>* hosts = [] {
+        const char* env = getenv("WK26_BYTECODE_HOSTS");
+        if (!env || !*env)
+            return static_cast<Vector<String>*>(nullptr);
+        auto* v = new Vector<String>;
+        for (auto& h : String::fromUTF8(env).split(','))
+            v->append(h.convertToASCIILowercase());
+        return v;
+    }();
+    if (!hosts)
+        return true;
+    String host = URL { sourceURL }.host().convertToASCIILowercase();
+    if (host.isEmpty())
+        return false;
+    for (auto& h : *hosts) {
+        if (host == h)
+            return true;
+        if (host.length() > h.length() && host.endsWith(h) && host[host.length() - h.length() - 1] == '.')
+            return true;
+    }
+    return false;
+}
+
+static size_t wk26MinSourceLength()
+{
+    static const size_t value = [] {
+        const char* env = getenv("WK26_BYTECODE_MINLEN");
+        return env && *env ? static_cast<size_t>(strtoull(env, nullptr, 10)) : wk26DefaultMinSourceLength;
+    }();
+    return value;
+}
+
+static uint64_t wk26DirectoryHighWater()
+{
+    static const uint64_t value = [] {
+        const char* env = getenv("WK26_BYTECODE_HIGHWATER");
+        uint64_t mb = env && *env ? strtoull(env, nullptr, 10) : 0;
+        return mb ? mb * 1024 * 1024 : wk26DefaultDirectoryHighWater;
+    }();
+    return value;
+}
+
+static uint64_t wk26DirectoryLowWater()
+{
+    return wk26DirectoryHighWater() / 6 * 5;
+}
+constexpr Seconds wk26CommitDebounce = 3_s;
+constexpr Seconds wk26CommitDeadline = 10_s;
+constexpr Seconds wk26ProgramOnlyCommitDelay = 300_ms;
+constexpr Seconds wk26WriterBusyRetry = 1_s;
+// Process-wide bound on encoded function updates not yet written.
+constexpr size_t wk26PendingUpdateBudget = 4u * 1024 * 1024;
+constexpr size_t wk26QueuedWriteLimit = 8u * 1024 * 1024; // assembled bytes queued for writing
+// A hit that gained functions is rewritten only for a gain of at least this
+// or 10% of the mapped file.
+constexpr size_t wk26MinRewriteGain = 128 * 1024;
+static size_t wk26RewriteGainFor(size_t mapped)
+{
+    return std::max(wk26MinRewriteGain, mapped / 10);
+}
+static const char* const wk26DefaultCacheDirectory = "/var/mobile/Library/Caches/com.apple.mobilesafari/wk26-bytecode";
+
+static const char* wk26CacheDirectory()
+{
+    static const char* const value = [] {
+        const char* env = getenv("WK26_BYTECODE_DIR");
+        return env && *env ? strdup(env) : wk26DefaultCacheDirectory;
+    }();
+    return value;
+}
+
+// The parent directory may not exist yet (e.g. on iOS 7); create it too.
+static void wk26MakeCacheDirectory()
+{
+    char parent[1024];
+    const char* dir = wk26CacheDirectory();
+    const char* slash = strrchr(dir, '/');
+    if (slash && slash != dir && static_cast<size_t>(slash - dir) < sizeof(parent)) {
+        memcpy(parent, dir, slash - dir);
+        parent[slash - dir] = 0;
+        mkdir(parent, 0755);
+    }
+    mkdir(dir, 0755);
+}
+
+struct WK26Trailer {
+    uint32_t magic;
+    uint16_t version;
+    uint16_t flags;
+    uint64_t payloadSize;
+    uint64_t hash;
+};
+constexpr uint32_t wk26TrailerMagic = 0x43423632; // '62BC'
+constexpr uint16_t wk26TrailerVersion = 2;
+constexpr uint16_t wk26TrailerHasFunctions = 1;
+static_assert(sizeof(WK26Trailer) == 24);
+
+// Per-process hit/miss tallies for the log.
+static unsigned wk26Hits, wk26MissNew, wk26MissChanged, wk26MissEvicted;
+static size_t wk26PendingUpdateBytes; // web thread
+static std::atomic<size_t> wk26QueuedWriteBytes; // += on dispatch, -= after the write
+
+// Debug logging, compiled out unless built with -DWK26_BCLOG=1.
+#ifndef WK26_BCLOG
+#define WK26_BCLOG 0
+#endif
+#if WK26_BCLOG
+static void wk26Log(const char* fmt, ...) WTF_ATTRIBUTE_PRINTF(1, 2);
+static void wk26Log(const char* fmt, ...)
+{
+    FILE* f = fopen("/tmp/wk26.log", "a");
+    if (!f)
+        return;
+    va_list ap;
+    va_start(ap, fmt);
+    fputs("[wk26bc] ", f);
+    vfprintf(f, fmt, ap);
+    fputc('\n', f);
+    va_end(ap);
+    fclose(f);
+}
+#else
+static inline void wk26Log(const char*, ...) WTF_ATTRIBUTE_PRINTF(1, 2);
+static inline void wk26Log(const char*, ...) { }
+#endif
+
+// Decoding touches most pages of a mapped hit, and iOS jetsam counts them as
+// resident. Periodically re-map the files in place (MAP_FIXED) to drop them;
+// the interval backs off from 2 s to 60 s while trims recover little.
+constexpr Seconds wk26TrimInterval = 2_s;
+constexpr Seconds wk26TrimIntervalMax = 60_s;
+constexpr size_t wk26TrimWorthwhileKB = 1024;
+constexpr Seconds wk26TrimWindow = 45_s;
+
+struct WK26Mapping {
+    RefPtr<JSC::CachedBytecode> bytecode;
+    int fd;
+    MonotonicTime hit;
+};
+
+static Vector<WK26Mapping>& wk26Mappings()
+{
+    static NeverDestroyed<Vector<WK26Mapping>> mappings;
+    return mappings;
+}
+
+static std::unique_ptr<Timer>& wk26TrimTimer()
+{
+    static NeverDestroyed<std::unique_ptr<Timer>> timer;
+    return timer;
+}
+
+static bool wk26TrimEnabled()
+{
+    return true;
+}
+
+static MonotonicTime wk26LastTrim;
+static Seconds wk26TrimDelay = wk26TrimInterval; // current back-off
+
+static void wk26TrimResetBackoff()
+{
+    wk26TrimDelay = wk26TrimInterval;
+}
+
+static size_t wk26ResidentKB()
+{
+    struct task_basic_info info;
+    mach_msg_type_number_t count = TASK_BASIC_INFO_COUNT;
+    if (task_info(mach_task_self(), TASK_BASIC_INFO, reinterpret_cast<task_info_t>(&info), &count) != KERN_SUCCESS)
+        return 0;
+    return info.resident_size / 1024;
+}
+
+static void wk26TrimResidentPages()
+{
+    auto& mappings = wk26Mappings();
+    MonotonicTime now = MonotonicTime::now();
+    size_t mappedBytes = 0;
+    unsigned remapped = 0, failed = 0;
+    size_t rssBefore = wk26ResidentKB();
+    for (size_t i = 0; i < mappings.size();) {
+        auto& m = mappings[i];
+        auto span = m.bytecode->span();
+        void* base = const_cast<uint8_t*>(span.data());
+        size_t size = span.size();
+        mappedBytes += size;
+        void* r = ::mmap(base, size, PROT_READ, MAP_FILE | MAP_PRIVATE | MAP_FIXED, m.fd, 0);
+        if (r == base)
+            remapped++;
+        else {
+            failed++;
+            wk26Log("trim: remap of %zu bytes at %p failed errno=%d", size, base, errno);
+        }
+        if (now - m.hit > wk26TrimWindow) {
+            close(m.fd);
+            mappings.removeAt(i);
+            continue;
+        }
+        ++i;
+    }
+    size_t rssAfter = wk26ResidentKB();
+    wk26LastTrim = MonotonicTime::now();
+    ssize_t recoveredKB = static_cast<ssize_t>(rssBefore) - static_cast<ssize_t>(rssAfter);
+    if (recoveredKB >= static_cast<ssize_t>(wk26TrimWorthwhileKB))
+        wk26TrimResetBackoff();
+    else
+        wk26TrimDelay = std::min(wk26TrimDelay * 2, wk26TrimIntervalMax);
+    if (remapped || failed)
+        wk26Log("trim: %u mappings / %zu KB remapped (%u failed): rss %zu -> %zu KB (-%zd), %zu tracked, next in %.0f s", remapped, mappedBytes / 1024, failed, rssBefore, rssAfter, recoveredKB, mappings.size(), wk26TrimDelay.seconds());
+    if (!mappings.isEmpty() && wk26TrimTimer())
+        wk26TrimTimer()->startOneShot(wk26TrimDelay);
+}
+
+// Also trim from the cache hooks (safe points on the web thread), since the
+// timer may be starved during a load. A new mapping restarts the back-off.
+static void wk26MaybeTrimNow(bool newMapping)
+{
+    if (!wk26TrimEnabled() || wk26Mappings().isEmpty())
+        return;
+    if (newMapping)
+        wk26TrimResetBackoff();
+    MonotonicTime now = MonotonicTime::now();
+    if (now - wk26LastTrim < std::max(1_s, wk26TrimDelay))
+        return;
+    wk26TrimResidentPages();
+}
+
+static void wk26TrackMapping(RefPtr<JSC::CachedBytecode> bytecode, int fd)
+{
+    wk26MaybeTrimNow(true);
+    if (!wk26TrimEnabled()) {
+        close(fd);
+        return;
+    }
+    wk26Mappings().append({ WTF::move(bytecode), fd, MonotonicTime::now() });
+    wk26TrimResetBackoff();
+    auto& timer = wk26TrimTimer();
+    if (!timer)
+        timer = makeUnique<Timer>([] { wk26TrimResidentPages(); });
+    if (!timer->isActive())
+        timer->startOneShot(wk26TrimInterval);
+}
+
+static bool wk26BytecodeCacheEnabled()
+{
+    return wk26BytecodeCacheDefaultOn;
+}
+
+// Word hash over the first and last 64 KB plus the size: a cheap check against
+// foreign or corrupt files (writes are atomic renames).
+static void wk26HashMix(uint32_t& a, uint32_t& b, std::span<const uint8_t> data)
+{
+    size_t words = data.size() / 4;
+    const uint8_t* p = data.data();
+    for (size_t i = 0; i < words; ++i, p += 4) {
+        uint32_t w;
+        memcpy(&w, p, 4);
+        a = (a ^ w) * 0x9E3779B1u;
+        b = (b + w) * 0xC2B2AE35u;
+        a ^= b >> 15;
+    }
+    for (size_t i = words * 4; i < data.size(); ++i)
+        a = (a ^ data[i]) * 0x9E3779B1u;
+}
+
+static uint64_t wk26PayloadHash(std::span<const uint8_t> data)
+{
+    constexpr size_t sample = 64 * 1024;
+    uint32_t a = 0x9E3779B9u, b = 0x85EBCA6Bu;
+    if (data.size() <= 2 * sample)
+        wk26HashMix(a, b, data);
+    else {
+        wk26HashMix(a, b, data.first(sample));
+        wk26HashMix(a, b, data.last(sample));
+    }
+    return (static_cast<uint64_t>(a) << 32) | (b ^ static_cast<uint32_t>(data.size()));
+}
+
+// Function updates re-encode nested executables and can grow without bound;
+// cap the file at 3x the source length, clamped to 1..8 MB.
+static size_t wk26UpdateCapFor(size_t sourceLength)
+{
+    return std::clamp<size_t>(sourceLength * 3, 1024 * 1024, 8 * 1024 * 1024);
+}
+
+static WorkQueue& wk26CacheQueue()
+{
+    static NeverDestroyed<Ref<WorkQueue>> queue = WorkQueue::create("wk26 bytecode cache"_s, WorkQueue::QOS::Utility);
+    return queue.get();
+}
+
+// Sidecar index of "<host>/<basename> <key>" lines (last wins), used to classify
+// misses and URL identities.
+static String wk26IndexPath()
+{
+    return makeString(unsafeSpan(wk26CacheDirectory()), "/.index"_s);
+}
+
+static String wk26IndexIdentity(const String& url)
+{
+    // Host + last path component: stable across cache-busting queries and paths.
+    URL u { url };
+    String path = u.path().toString();
+    size_t slash = path.reverseFind('/');
+    String base = slash == notFound ? path : path.substring(slash + 1);
+    if (base.length() > 80)
+        base = base.right(80);
+    return makeString(u.host(), '/', base);
+}
+
+static HashMap<String, String>& wk26Index()
+{
+    static NeverDestroyed<HashMap<String, String>> map;
+    static bool loaded = false;
+    if (loaded)
+        return map.get();
+    loaded = true;
+    FILE* f = fopen(wk26IndexPath().utf8().data(), "r");
+    if (!f)
+        return map.get();
+    char line[512];
+    unsigned lines = 0;
+    while (fgets(line, sizeof(line), f)) {
+        lines++;
+        char* space = strchr(line, ' ');
+        if (!space)
+            continue;
+        *space = 0;
+        char* key = space + 1;
+        size_t n = strlen(key);
+        while (n && (key[n - 1] == '\n' || key[n - 1] == '\r'))
+            key[--n] = 0;
+        if (!n)
+            continue;
+        map->set(String::fromUTF8(line), String::fromUTF8(key));
+    }
+    fclose(f);
+    if (lines > 4000) {
+        // Compact.
+        StringBuilder out;
+        for (auto& it : map.get())
+            out.append(it.key, ' ', it.value, '\n');
+        CString bytes = out.toString().utf8();
+        CString path = wk26IndexPath().utf8();
+        wk26CacheQueue().dispatch([bytes = WTF::move(bytes), path = WTF::move(path)] {
+            FILE* w = fopen(path.data(), "w");
+            if (!w)
+                return;
+            fwrite(bytes.data(), 1, bytes.length(), w);
+            fclose(w);
+        });
+    }
+    return map.get();
+}
+
+static void wk26IndexRecord(const String& identity, const String& key)
+{
+    auto& map = wk26Index();
+    auto it = map.find(identity);
+    if (it != map.end() && it->value == key)
+        return;
+    map.set(identity, key);
+    CString line = makeString(identity, ' ', key, '\n').utf8();
+    CString path = wk26IndexPath().utf8();
+    wk26CacheQueue().dispatch([line = WTF::move(line), path = WTF::move(path)] {
+        wk26MakeCacheDirectory();
+        FILE* f = fopen(path.data(), "a");
+        if (!f)
+            return;
+        fwrite(line.data(), 1, line.length(), f);
+        fclose(f);
+    });
+}
+
+// Full mode sighting record: one "<key>" line per sighting of a script that was
+// not compiled whole.
+static String wk26SeenPath()
+{
+    return makeString(unsafeSpan(wk26CacheDirectory()), "/.seen"_s);
+}
+
+static HashMap<String, unsigned>& wk26Seen()
+{
+    static NeverDestroyed<HashMap<String, unsigned>> map;
+    static bool loaded = false;
+    if (loaded)
+        return map.get();
+    loaded = true;
+    FILE* f = fopen(wk26SeenPath().utf8().data(), "r");
+    if (!f)
+        return map.get();
+    char line[128];
+    unsigned lines = 0;
+    while (fgets(line, sizeof(line), f)) {
+        lines++;
+        size_t n = strlen(line);
+        while (n && (line[n - 1] == '\n' || line[n - 1] == '\r'))
+            line[--n] = 0;
+        if (!n)
+            continue;
+        map->add(String::fromUTF8(line), 0).iterator->value++;
+    }
+    fclose(f);
+    if (lines > 8000) {
+        StringBuilder out;
+        for (auto& it : map.get()) {
+            for (unsigned i = 0; i < it.value; ++i)
+                out.append(it.key, '\n');
+        }
+        CString bytes = out.toString().utf8();
+        CString path = wk26SeenPath().utf8();
+        wk26CacheQueue().dispatch([bytes = WTF::move(bytes), path = WTF::move(path)] {
+            FILE* w = fopen(path.data(), "w");
+            if (!w)
+                return;
+            fwrite(bytes.data(), 1, bytes.length(), w);
+            fclose(w);
+        });
+    }
+    return map.get();
+}
+
+static unsigned wk26SeenRecord(const String& key)
+{
+    unsigned count = ++wk26Seen().add(key, 0).iterator->value;
+    CString line = makeString(key, '\n').utf8();
+    CString path = wk26SeenPath().utf8();
+    wk26CacheQueue().dispatch([line = WTF::move(line), path = WTF::move(path)] {
+        wk26MakeCacheDirectory();
+        FILE* f = fopen(path.data(), "a");
+        if (!f)
+            return;
+        fwrite(line.data(), 1, line.length(), f);
+        fclose(f);
+    });
+    return count;
+}
+
+// URL identities whose content changes more often than it hits (e.g. combined
+// module bundles) are volatile; their scripts are compiled whole only once seen
+// before. Tracked in `.churn` as "C <identity>" / "H <identity>" lines.
+constexpr unsigned wk26VolatileAfter = 3;
+
+static String wk26ChurnPath()
+{
+    return makeString(unsafeSpan(wk26CacheDirectory()), "/.churn"_s);
+}
+
+struct WK26Churn { unsigned changes { 0 }; unsigned hits { 0 }; };
+
+static HashMap<String, WK26Churn>& wk26Churn()
+{
+    static NeverDestroyed<HashMap<String, WK26Churn>> map;
+    static bool loaded = false;
+    if (loaded)
+        return map.get();
+    loaded = true;
+    FILE* f = fopen(wk26ChurnPath().utf8().data(), "r");
+    if (!f)
+        return map.get();
+    char line[512];
+    unsigned lines = 0;
+    while (fgets(line, sizeof(line), f)) {
+        lines++;
+        size_t n = strlen(line);
+        while (n && (line[n - 1] == '\n' || line[n - 1] == '\r'))
+            line[--n] = 0;
+        if (n < 3 || line[1] != ' ' || (line[0] != 'C' && line[0] != 'H'))
+            continue;
+        auto& c = map->add(String::fromUTF8(line + 2), WK26Churn { }).iterator->value;
+        if (line[0] == 'C')
+            c.changes++;
+        else
+            c.hits++;
+    }
+    fclose(f);
+    if (lines > 8000) {
+        StringBuilder out;
+        for (auto& it : map.get()) {
+            for (unsigned i = 0; i < it.value.changes; ++i)
+                out.append("C "_s, it.key, '\n');
+            for (unsigned i = 0; i < it.value.hits; ++i)
+                out.append("H "_s, it.key, '\n');
+        }
+        CString bytes = out.toString().utf8();
+        CString path = wk26ChurnPath().utf8();
+        wk26CacheQueue().dispatch([bytes = WTF::move(bytes), path = WTF::move(path)] {
+            FILE* w = fopen(path.data(), "w");
+            if (!w)
+                return;
+            fwrite(bytes.data(), 1, bytes.length(), w);
+            fclose(w);
+        });
+    }
+    return map.get();
+}
+
+static void wk26ChurnRecord(char kind, const String& identity)
+{
+    auto& c = wk26Churn().add(identity, WK26Churn { }).iterator->value;
+    if (kind == 'C')
+        c.changes++;
+    else
+        c.hits++;
+    CString line = makeString(kind, ' ', identity, '\n').utf8();
+    CString path = wk26ChurnPath().utf8();
+    wk26CacheQueue().dispatch([line = WTF::move(line), path = WTF::move(path)] {
+        wk26MakeCacheDirectory();
+        FILE* f = fopen(path.data(), "a");
+        if (!f)
+            return;
+        fwrite(line.data(), 1, line.length(), f);
+        fclose(f);
+    });
+}
+
+// Volatile: enough changes, and more changes than hits.
+static bool wk26IdentityVolatile(const String& identity, unsigned& changes, unsigned& hits)
+{
+    changes = hits = 0;
+    auto& map = wk26Churn();
+    auto it = map.find(identity);
+    if (it == map.end())
+        return false;
+    changes = it->value.changes;
+    hits = it->value.hits;
+    return changes >= wk26VolatileAfter && changes > hits;
+}
+
+// LRU-evict by mtime down to the low-water mark. Runs on the work queue.
+static void wk26EvictIfNeeded()
+{
+    DIR* dir = opendir(wk26CacheDirectory());
+    if (!dir)
+        return;
+    struct Entry { CString path; uint64_t size; time_t mtime; };
+    Vector<Entry> entries;
+    uint64_t total = 0;
+    while (struct dirent* e = readdir(dir)) {
+        if (e->d_name[0] == '.')
+            continue;
+        CString path = makeString(unsafeSpan(wk26CacheDirectory()), '/', unsafeSpan(e->d_name)).utf8();
+        struct stat st;
+        if (stat(path.data(), &st) || !S_ISREG(st.st_mode))
+            continue;
+        size_t nameLength = strlen(e->d_name);
+        if (nameLength > 4 && !strcmp(e->d_name + nameLength - 4, ".tmp") && st.st_mtime + 300 < time(nullptr)) {
+            unlink(path.data()); // abandoned temp file
+            continue;
+        }
+        unsigned dashes = 0;
+        for (size_t i = 0; i < nameLength; ++i)
+            dashes += e->d_name[i] == '-';
+        if (dashes != 2) {
+            unlink(path.data()); // old-format file
+            continue;
+        }
+        total += st.st_size;
+        entries.append({ WTF::move(path), static_cast<uint64_t>(st.st_size), st.st_mtime });
+    }
+    closedir(dir);
+    if (total <= wk26DirectoryHighWater())
+        return;
+    std::sort(entries.begin(), entries.end(), [](const Entry& x, const Entry& y) { return x.mtime < y.mtime; });
+    unsigned evicted = 0;
+    for (auto& entry : entries) {
+        if (total <= wk26DirectoryLowWater())
+            break;
+        if (!unlink(entry.path.data())) {
+            total -= entry.size;
+            evicted++;
+        }
+    }
+    wk26Log("evict: %u files, dir now %llu KB", evicted, static_cast<unsigned long long>(total / 1024));
+}
+
+// Assemble payload + updates + trailer on the web thread; CachedBytecode is not
+// thread-safe, so only the bytes go to the work queue.
+static bool wk26AssembleCacheFile(const JSC::CachedBytecode& bytecode, Vector<uint8_t>& buffer, uint16_t flags)
+{
+    size_t total = bytecode.sizeForUpdate();
+    if (!buffer.tryReserveCapacity(total + sizeof(WK26Trailer)))
+        return false;
+    buffer.grow(total);
+    auto base = bytecode.span();
+    if (!base.empty())
+        memcpy(buffer.mutableSpan().data(), base.data(), base.size());
+    bool overflow = false;
+    bytecode.commitUpdates([&](off_t offset, std::span<const uint8_t> data) {
+        if (offset < 0 || static_cast<size_t>(offset) + data.size() > total) {
+            overflow = true;
+            return;
+        }
+        memcpy(buffer.mutableSpan().data() + offset, data.data(), data.size());
+    });
+    if (overflow)
+        return false;
+    WK26Trailer trailer { wk26TrailerMagic, wk26TrailerVersion, flags, static_cast<uint64_t>(total), wk26PayloadHash(buffer.span()) };
+    buffer.append(std::span<const uint8_t> { reinterpret_cast<const uint8_t*>(&trailer), sizeof(trailer) });
+    return true;
+}
+
+// Write the assembled file to a temp path and rename it into place (work queue).
+static void wk26WriteCacheFile(const Vector<uint8_t>& buffer, const CString& path, const CString& label)
+{
+    MonotonicTime t0 = MonotonicTime::now();
+    wk26MakeCacheDirectory();
+    CString tempPath = makeString(unsafeSpan(path.data()), ".tmp"_s).utf8();
+    int fd = open(tempPath.data(), O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    if (fd < 0) {
+        wk26Log("write %s: open %s failed errno=%d", label.data(), tempPath.data(), errno);
+        return;
+    }
+    size_t written = 0;
+    bool failed = false;
+    while (written < buffer.size()) {
+        ssize_t n = write(fd, buffer.span().data() + written, buffer.size() - written);
+        if (n <= 0) {
+            if (n < 0 && errno == EINTR)
+                continue;
+            failed = true;
+            break;
+        }
+        written += n;
+    }
+    close(fd);
+    if (failed || rename(tempPath.data(), path.data())) {
+        wk26Log("write %s: write/rename failed errno=%d", label.data(), errno);
+        unlink(tempPath.data());
+        return;
+    }
+    wk26Log("wrote %s: %zu bytes in %.1f ms", label.data(), buffer.size(), (MonotonicTime::now() - t0).milliseconds());
+    wk26EvictIfNeeded();
+}
+
+} // namespace
+
+CachedScriptSourceProvider::~CachedScriptSourceProvider()
+{
+    // Flush pending updates whose debounce never fired.
+    if (m_wk26Bytecode && m_wk26Bytecode->hasUpdates())
+        wk26Commit(true);
+    m_cachedScript->removeClient(*this);
+}
+
+bool CachedScriptSourceProvider::wk26BytecodeEligible() const
+{
+    if (m_wk26State == 3)
+        return false;
+    if (m_wk26State)
+        return true;
+    bool eligible = wk26BytecodeCacheEnabled()
+        && (sourceType() == JSC::SourceProviderSourceType::Program || sourceType() == JSC::SourceProviderSourceType::Module)
+        && sourceURL().startsWith("http"_s)
+        && wk26HostEligible(sourceURL())
+        && source().length() >= wk26MinSourceLength();
+    m_wk26State = eligible ? 1 : 3;
+    return eligible;
+}
+
+// Full mode sighting policy, decided once per provider after cachedBytecode()
+// has classified the miss. Posts Darwin notifications around the eager compile.
+bool CachedScriptSourceProvider::wk26CompilesWhole() const
+{
+    if (m_wk26Eager)
+        return m_wk26Eager == 1;
+    bool eager = false;
+    const char* why = "";
+    if (!wk26BytecodeFullMode() || !wk26BytecodeEligible())
+        why = "not full mode";
+    else if (source().length() > wk26FullMaxLength) {
+        wk26Log("capped %s (%u chars): over %zu, program now, functions on later hits", sourceURL().utf8().data(), source().length(), wk26FullMaxLength);
+        m_wk26Eager = 3;
+        return false;
+    } else if (m_wk26State == 2 || m_wk26MissKind == 3) {
+        // The store had a file for this key, so the script recurs.
+        eager = true;
+        why = m_wk26State == 2 ? "stale file" : "evicted file";
+    } else if (unsigned changes = 0, hits = 0; wk26IdentityVolatile(wk26IndexIdentity(sourceURL()), changes, hits)) {
+        // Volatile identity: compile whole only once seen before.
+        String key = wk26CacheKey();
+        auto& seen = wk26Seen();
+        auto it = seen.find(key);
+        unsigned before = it == seen.end() ? 0 : it->value;
+        if (before >= wk26FullAfter) {
+            eager = true;
+            why = "seen before (volatile identity)";
+        } else {
+            unsigned now = wk26SeenRecord(key);
+            wk26Log("lazy %s (%u chars): volatile identity (%u changes vs %u hits), sighting %u of %u, parsed lazily, nothing written", sourceURL().utf8().data(), source().length(), changes, hits, now, wk26FullAfter + 1);
+        }
+    } else if (wk26BytecodeFullFirst()) {
+        eager = true;
+        why = "first sight (WK26_BYTECODE_FULL_FIRST)";
+    } else if (m_wk26MissKind == 2) {
+        eager = true;
+        why = "known identity, new content";
+    } else {
+        String key = wk26CacheKey();
+        auto& seen = wk26Seen();
+        auto it = seen.find(key);
+        unsigned before = it == seen.end() ? 0 : it->value;
+        if (before >= wk26FullAfter) {
+            eager = true;
+            why = "seen before";
+        } else {
+            unsigned now = wk26SeenRecord(key);
+            wk26Log("lazy %s (%u chars): sighting %u of %u, parsed lazily, nothing written", sourceURL().utf8().data(), source().length(), now, wk26FullAfter + 1);
+        }
+    }
+    if (eager)
+        wk26Log("whole %s (%u chars): %s", sourceURL().utf8().data(), source().length(), why);
+    m_wk26Eager = eager ? 1 : 2;
+    return eager;
+}
+
+// Scripts over wk26FullMaxLength use the two-visit path even in full mode.
+bool CachedScriptSourceProvider::wk26CappedScript() const
+{
+    if (m_wk26Eager == 3)
+        return true;
+    return source().length() > wk26FullMaxLength;
+}
+
+bool CachedScriptSourceProvider::eagerlyCompilesFunctionsForCache() const
+{
+    bool full = wk26CompilesWhole();
+    if (full)
+        notify_post("me.lululab.wk26.bytecode.compiling");
+    return full;
+}
+
+String CachedScriptSourceProvider::wk26CacheKey() const
+{
+    // Content-only key; JSC re-checks the source via the SourceCodeKey in the payload.
+    return makeString(hex(hash(), 8, Lowercase), '-', source().length(), '-', isModuleType() ? 'm' : 'p');
+}
+
+String CachedScriptSourceProvider::wk26CachePath() const
+{
+    return makeString(unsafeSpan(wk26CacheDirectory()), '/', wk26CacheKey(), ".bc"_s);
+}
+
+RefPtr<JSC::CachedBytecode> CachedScriptSourceProvider::cachedBytecode() const
+{
+    if (!wk26BytecodeEligible())
+        return nullptr;
+    if (m_wk26State == 2)
+        return m_wk26Bytecode.copyRef();
+    if (m_wk26Bytecode)
+        return nullptr; // a miss buffer is still being filled
+
+    MonotonicTime t0 = MonotonicTime::now();
+    String path = wk26CachePath();
+    std::optional<FileSystem::MappedFileData> mapped;
+    int fd = -1;
+    {
+        auto handle = FileSystem::openFile(path, FileSystem::FileOpenMode::Read);
+        if (handle) {
+            mapped = handle.map(FileSystem::MappedFileMode::Private);
+            if (mapped)
+                fd = dup(handle.platformHandle()); // kept for the resident-page trim
+        }
+    }
+    if (!mapped) {
+        String key = wk26CacheKey();
+        String identity = wk26IndexIdentity(sourceURL());
+        auto& index = wk26Index();
+        auto it = index.find(identity);
+        const char* why;
+        String was;
+        if (it == index.end()) {
+            why = "new";
+            m_wk26MissKind = 1;
+            wk26MissNew++;
+        } else if (it->value != key) {
+            why = "changed";
+            was = it->value;
+            m_wk26MissKind = 2;
+            wk26MissChanged++;
+            wk26ChurnRecord('C', identity);
+        } else {
+            why = "evicted";
+            m_wk26MissKind = 3;
+            wk26MissEvicted++;
+        }
+        wk26Log("miss %s %s (%u chars)%s%s [hit=%u new=%u changed=%u evicted=%u]", why, sourceURL().utf8().data(), source().length(),
+            was.isEmpty() ? "" : " was ", was.utf8().data(), wk26Hits, wk26MissNew, wk26MissChanged, wk26MissEvicted);
+        return nullptr;
+    }
+    auto span = mapped->span();
+    bool valid = false;
+    WK26Trailer trailer { };
+    if (span.size() >= sizeof(WK26Trailer)) {
+        memcpy(&trailer, span.data() + span.size() - sizeof(WK26Trailer), sizeof(trailer));
+        if (trailer.magic == wk26TrailerMagic && trailer.version == wk26TrailerVersion
+            && trailer.payloadSize == span.size() - sizeof(WK26Trailer)
+            && trailer.hash == wk26PayloadHash(span.first(trailer.payloadSize)))
+            valid = true;
+    }
+    if (!valid) {
+        wk26Log("corrupt %s: %zu bytes, deleting", path.utf8().data(), span.size());
+        mapped = std::nullopt;
+        if (fd >= 0)
+            close(fd);
+        unlink(path.utf8().data());
+        return nullptr;
+    }
+    utimes(path.utf8().data(), nullptr); // LRU touch
+    m_wk26Bytecode = JSC::CachedBytecode::create(WTF::move(*mapped));
+    if (fd >= 0)
+        wk26TrackMapping(m_wk26Bytecode, fd);
+    // On a hit, functions the page runs are added to the file.
+    m_wk26HasFunctions = trailer.flags & wk26TrailerHasFunctions;
+    m_wk26UpdateCap = wk26UpdateCapFor(source().length());
+    m_wk26State = 2;
+    wk26Hits++;
+    wk26ChurnRecord('H', wk26IndexIdentity(sourceURL()));
+    wk26Log("hit %s%s: %zu bytes mapped in %.1f ms [hit=%u new=%u changed=%u evicted=%u]", sourceURL().utf8().data(), m_wk26HasFunctions ? " (+fn)" : " (program)", span.size(),
+        (MonotonicTime::now() - t0).milliseconds(), wk26Hits, wk26MissNew, wk26MissChanged, wk26MissEvicted);
+    return m_wk26Bytecode.copyRef();
+}
+
+void CachedScriptSourceProvider::cacheBytecode(const JSC::BytecodeCacheGenerator& generator) const
+{
+    if (!wk26BytecodeEligible())
+        return;
+    if (m_wk26State == 2) {
+        // The cached payload failed to decode; rebuild. The first payload word is
+        // JSC's cache version, logged to tell an engine update from other causes.
+        wk26CompilesWhole(); // decide while the state still records the stale file
+        const char* reason = "no payload";
+        if (m_wk26Bytecode) {
+            auto span = m_wk26Bytecode->span();
+            uint32_t version = 0;
+            if (span.size() >= sizeof(version))
+                memcpy(&version, span.data(), sizeof(version));
+            reason = version == JSC::computeJSCBytecodeCacheVersion() ? "same engine version, decode failed" : "engine version changed";
+        }
+        wk26Log("stale %s: %s, rebuilding", sourceURL().utf8().data(), reason);
+        m_wk26Bytecode = nullptr;
+        m_wk26State = 1;
+    }
+    if (m_wk26Bytecode)
+        return; // already encoded by an earlier parse
+    if (wk26BytecodeFullMode() && !wk26CompilesWhole() && m_wk26Eager != 3)
+        return; // full mode first sighting: nothing written
+    MonotonicTime t0 = MonotonicTime::now();
+    RefPtr<JSC::CachedBytecode> update = generator();
+    if (!update || !update->size())
+        return;
+    m_wk26Bytecode = JSC::CachedBytecode::create();
+    m_wk26Bytecode->addGlobalUpdate(update.releaseNonNull());
+    // First visit writes the program only (full mode already includes every function).
+    m_wk26UpdateCap = 0;
+    m_wk26HasFunctions = wk26BytecodeFullMode() && wk26CompilesWhole();
+    wk26Log("encode %s%s: %zu bytes in %.1f ms", sourceURL().utf8().data(), m_wk26HasFunctions ? " (full)" : "", m_wk26Bytecode->sizeForUpdate(), (MonotonicTime::now() - t0).milliseconds());
+    if (m_wk26HasFunctions)
+        notify_post("me.lululab.wk26.bytecode.compiled");
+    wk26ScheduleCommit();
+}
+
+void CachedScriptSourceProvider::updateCache(const JSC::UnlinkedFunctionExecutable* executable, const JSC::SourceCode&, JSC::CodeSpecializationKind kind, const JSC::UnlinkedFunctionCodeBlock* codeBlock) const
+{
+    wk26MaybeTrimNow(false);
+    if (!m_wk26Bytecode)
+        return;
+    if (wk26BytecodeFullMode() && !wk26CappedScript())
+        return; // the file already holds every function
+    if (m_wk26Bytecode->sizeForUpdate() >= m_wk26UpdateCap)
+        return;
+    if (wk26PendingUpdateBytes >= wk26PendingUpdateBudget)
+        return; // pending update budget exhausted
+    // Only registered leaf executables have a slot to patch.
+    if (!m_wk26Bytecode->leafExecutables().contains(executable))
+        return;
+    JSC::BytecodeCacheError error;
+    RefPtr<JSC::CachedBytecode> update = JSC::encodeFunctionCodeBlock(executable->vm(), codeBlock, error);
+    if (!update || error.isValid())
+        return;
+    size_t bytes = update->size();
+    m_wk26Bytecode->addFunctionUpdate(executable, kind, update.releaseNonNull());
+    m_wk26Updates++;
+    m_wk26UpdateBytes += bytes;
+    wk26PendingUpdateBytes += bytes;
+    wk26ScheduleCommit();
+}
+
+void CachedScriptSourceProvider::wk26ScheduleCommit() const
+{
+    MonotonicTime now = MonotonicTime::now();
+    if (!m_wk26FirstUpdate)
+        m_wk26FirstUpdate = now;
+    if (!m_wk26CommitTimer)
+        m_wk26CommitTimer = makeUnique<Timer>([this] { wk26Commit(false); });
+    Seconds untilDeadline = wk26CommitDeadline - (now - m_wk26FirstUpdate);
+    Seconds delay = std::min(m_wk26UpdateCap ? wk26CommitDebounce : wk26ProgramOnlyCommitDelay, std::max(untilDeadline, 200_ms));
+    if (m_wk26CommitTimer->isActive() && untilDeadline <= 0_s)
+        return; // deadline already armed
+    m_wk26CommitTimer->startOneShot(delay);
+}
+
+void CachedScriptSourceProvider::commitCachedBytecode() const
+{
+    wk26Commit(false);
+}
+
+void CachedScriptSourceProvider::wk26Commit(bool destroying) const
+{
+    if (!m_wk26Bytecode)
+        return;
+    if (m_wk26CommitTimer)
+        m_wk26CommitTimer->stop();
+    if (m_wk26State == 2 && m_wk26Bytecode->hasUpdates() && !destroying) {
+        // Rewrite a hit only for a worthwhile gain; otherwise wait for the deadline.
+        size_t mapped = m_wk26Bytecode->span().size();
+        if (m_wk26UpdateBytes < wk26RewriteGainFor(mapped) && (MonotonicTime::now() - m_wk26FirstUpdate) < wk26CommitDeadline)
+            return;
+    }
+    if (!destroying && wk26QueuedWriteBytes.load() > wk26QueuedWriteLimit) {
+        // The writer is behind; retry later.
+        if (m_wk26CommitTimer)
+            m_wk26CommitTimer->startOneShot(wk26WriterBusyRetry);
+        return;
+    }
+    RefPtr<JSC::CachedBytecode> bytecode = std::exchange(m_wk26Bytecode, nullptr);
+    m_wk26FirstUpdate = MonotonicTime();
+    wk26PendingUpdateBytes -= std::min(wk26PendingUpdateBytes, m_wk26UpdateBytes);
+    size_t updateBytes = std::exchange(m_wk26UpdateBytes, 0);
+    if (!bytecode->hasUpdates()) {
+        // A hit with nothing new: leave the file alone.
+        return;
+    }
+    if (m_wk26State == 2 && updateBytes < wk26RewriteGainFor(bytecode->span().size())) {
+        wk26Log("skip %s: +%u functions / %zu bytes not worth a rewrite", sourceURL().utf8().data(), m_wk26Updates, updateBytes);
+        m_wk26Updates = 0;
+        return;
+    }
+    // From here a re-parse starts a fresh miss buffer; the file is being replaced.
+    m_wk26State = 1;
+    unsigned updates = std::exchange(m_wk26Updates, 0);
+    CString label = makeString(sourceURL(), " (+"_s, updates, " functions)"_s).utf8();
+    CString path = wk26CachePath().utf8();
+    if (!updates)
+        wk26IndexRecord(wk26IndexIdentity(sourceURL()), wk26CacheKey()); // new file
+    MonotonicTime t0 = MonotonicTime::now();
+    Vector<uint8_t> buffer;
+    if (!wk26AssembleCacheFile(*bytecode, buffer, (updates || m_wk26HasFunctions) ? wk26TrailerHasFunctions : 0)) {
+        wk26Log("assemble %s: failed (%zu bytes), dropped", label.data(), bytecode->sizeForUpdate());
+        return;
+    }
+    bytecode = nullptr; // release encoder buffers before the write
+    wk26Log("assemble %s: %zu bytes in %.1f ms", label.data(), buffer.size(), (MonotonicTime::now() - t0).milliseconds());
+    wk26QueuedWriteBytes += buffer.size();
+    wk26CacheQueue().dispatch([buffer = WTF::move(buffer), path = WTF::move(path), label = WTF::move(label)] {
+        wk26WriteCacheFile(buffer, path, label);
+        wk26QueuedWriteBytes -= buffer.size();
+    });
+}
+
+} // namespace WebCore
