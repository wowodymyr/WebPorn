+// WK26: iOS 6 NSTextAttachment throws on a file wrapper name without an extension.
+// Add one sniffed from the image bytes, defaulting to "png".
+NSString *filenameByAddingImageExtensionIfMissing(NSString *filename, NSData *data)
+{
+    if (![filename length])
+        filename = @"image";
+    if ([[filename pathExtension] length])
+        return filename;
+    NSString *extension = @"png";
+    if ([data length] >= 12) {
+        auto bytes = static_cast<const uint8_t*>([data bytes]);
+        if (!memcmp(bytes, "\xFF\xD8\xFF", 3))
+            extension = @"jpg";
+        else if (!memcmp(bytes, "GIF8", 4))
+            extension = @"gif";
+        else if (!memcmp(bytes, "RIFF", 4) && !memcmp(bytes + 8, "WEBP", 4))
+            extension = @"webp";
+        else if (!memcmp(bytes, "BM", 2))
+            extension = @"bmp";
+        else if (!memcmp(bytes, "II*\0", 4) || !memcmp(bytes, "MM\0*", 4))
+            extension = @"tiff";
+        else if (!memcmp(bytes + 4, "ftyp", 4))
+            extension = @"heic";
+        else if (bytes[0] == '<')
+            extension = @"svg";
+    }
+    return [filename stringByAppendingPathExtension:extension];
+}
