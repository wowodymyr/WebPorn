 namespace WebCore {
 
+// WK26 diagnostic: rings of recently destroyed Frames and Pages (kept separate so
+// Frame churn does not evict Pages), each with thread, web-lock state and backtrace.
+namespace {
+struct WK26DeadObject {
+    const void* object { nullptr };
+    int onMain { 0 };
+    int onWeb { 0 };
+    int locked { 0 };
+    int trailCount { 0 };
+    void* trail[10] { };
+};
+}
+static constexpr unsigned wk26DeadFrameCount = 64;
+static constexpr unsigned wk26DeadPageCount = 32;
+static Lock wk26DeadObjectLock;
+static WK26DeadObject wk26DeadFrames[wk26DeadFrameCount];
+static WK26DeadObject wk26DeadPages[wk26DeadPageCount];
+static unsigned wk26DeadFrameCursor;
+static unsigned wk26DeadPageCursor;
+
+static WK26DeadObject* wk26Ring(char kind, unsigned& count, unsigned*& cursor)
+{
+    if (kind == 'P') {
+        count = wk26DeadPageCount;
+        cursor = &wk26DeadPageCursor;
+        return wk26DeadPages;
+    }
+    count = wk26DeadFrameCount;
+    cursor = &wk26DeadFrameCursor;
+    return wk26DeadFrames;
+}
+
+void wk26NoteObjectDestroyed(const void* object, char kind)
+{
+    unsigned count = 0;
+    unsigned* cursor = nullptr;
+    void* trail[10];
+    int trailCount = backtrace(trail, 10);
+
+    Locker locker { wk26DeadObjectLock };
+    auto* ring = wk26Ring(kind, count, cursor);
+    auto& slot = ring[*cursor % count];
+    slot.object = object;
+    slot.onMain = pthread_main_np() ? 1 : 0;
+#if PLATFORM(IOS_FAMILY)
+    slot.onWeb = WebThreadIsCurrent() ? 1 : 0;
+    slot.locked = WebThreadIsLocked() ? 1 : 0;
+#endif
+    slot.trailCount = trailCount > 10 ? 10 : trailCount;
+    for (int i = 0; i < slot.trailCount; ++i)
+        slot.trail[i] = trail[i];
+    ++*cursor;
+}
+
+// Constructors clear their address so a reused address is not reported as dead.
+void wk26ForgetDestroyedObject(const void* object)
+{
+    Locker locker { wk26DeadObjectLock };
+    for (unsigned i = 0; i < wk26DeadFrameCount; ++i)
+        if (wk26DeadFrames[i].object == object)
+            wk26DeadFrames[i].object = nullptr;
+    for (unsigned i = 0; i < wk26DeadPageCount; ++i)
+        if (wk26DeadPages[i].object == object)
+            wk26DeadPages[i].object = nullptr;
+}
+
+bool wk26WasObjectDestroyed(const void* object, char kind, const char* what)
+{
+    unsigned count = 0;
+    unsigned* cursor = nullptr;
+    WK26DeadObject record;
+    {
+        Locker locker { wk26DeadObjectLock };
+        auto* ring = wk26Ring(kind, count, cursor);
+        unsigned i = 0;
+        for (; i < count; ++i) {
+            if (ring[i].object == object)
+                break;
+        }
+        if (i == count)
+            return false;
+        record = ring[i];
+    }
+
+    WK26_WTFLOG("[wk26life] %s: %p was ALREADY DESTROYED "
+        "(onMainThread=%d onWebThread=%d webLockHeld=%d) -- freed from:",
+        what, object, record.onMain, record.onWeb, record.locked);
+    for (int i = 0; i < record.trailCount; ++i) {
+        Dl_info info;
+        if (dladdr(record.trail[i], &info) && info.dli_fname) {
+            const char* base = strrchr(info.dli_fname, '/');
+            WK26_WTFLOG("[wk26life]    %p %s + %ld (%s)", record.trail[i],
+                base ? base + 1 : info.dli_fname,
+                static_cast<long>(static_cast<const char*>(record.trail[i]) - static_cast<const char*>(info.dli_saddr ? info.dli_saddr : info.dli_fbase)),
+                info.dli_sname ? info.dli_sname : "?");
+        } else
+            WK26_WTFLOG("[wk26life]    %p ?", record.trail[i]);
+    }
+    return true;
+}
