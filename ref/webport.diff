 static CFBundleRef webCoreBundleSingleton()
 {
+#if PLATFORM(IOS_FAMILY)
+    // wk26: com.apple.WebCore resolves to the system iOS 6 framework, which lacks newer
+    // strings; locate the bundle from this image's path, falling back to the identifier.
+
+    static NeverDestroyed<RetainPtr<CFBundleRef>> bundle = [] () -> RetainPtr<CFBundleRef> {
+        Dl_info info;
+        if (dladdr(reinterpret_cast<const void*>(&webCoreBundleSingleton), &info) && info.dli_fname) {
+            String path = String::fromUTF8(info.dli_fname);
+            size_t slash = path.reverseFind('/');
+            if (slash != notFound) {
+                auto directory = path.left(slash).utf8();
+                auto url = adoptCF(CFURLCreateFromFileSystemRepresentation(kCFAllocatorDefault, reinterpret_cast<const UInt8*>(directory.data()), directory.length(), true));
+                if (url) {
+                    if (auto ours = adoptCF(CFBundleCreate(kCFAllocatorDefault, url.get())))
+                        return ours;
+                }
+            }
+        }
+        return CFBundleGetBundleWithIdentifier(CFSTR("com.apple.WebCore"));
+    }();
+#else
     static NeverDestroyed<RetainPtr<CFBundleRef>> bundle = CFBundleGetBundleWithIdentifier(CFSTR("com.apple.WebCore"));
+#endif
     ASSERT(bundle.get());
     return bundle.get().get();
 }
