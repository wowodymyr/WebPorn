+// wk26: recursively compile nested functions so the bytecode cache encoder finds a
+// code block on every UnlinkedFunctionExecutable. Parse errors are left to the lazy path.
+static void eagerlyCompileNestedFunctions(VM& vm, UnlinkedCodeBlock* codeBlock, const SourceCode& parentSource, OptionSet<CodeGenerationMode> codeGenerationMode, unsigned& compiled, unsigned depth)
+{
+    if (!codeBlock || depth > 256)
+        return;
+    auto visit = [&](UnlinkedFunctionExecutable* executable) {
+        if (!executable || executable->isBuiltinFunction())
+            return;
+        SourceCode source = executable->linkedSourceCode(parentSource);
+        ParserError error;
+        UnlinkedFunctionCodeBlock* call = executable->unlinkedCodeBlockFor(vm, source, CodeSpecializationKind::CodeForCall, codeGenerationMode, error, executable->parseMode());
+        if (!call || error.isValid())
+            return;
+        compiled++;
+        if (executable->constructAbility() == ConstructAbility::CanConstruct) {
+            ParserError constructError;
+            if (executable->unlinkedCodeBlockFor(vm, source, CodeSpecializationKind::CodeForConstruct, codeGenerationMode, constructError, executable->parseMode()) && !constructError.isValid())
+                compiled++;
+        }
+        eagerlyCompileNestedFunctions(vm, call, source, codeGenerationMode, compiled, depth + 1);
+    };
+    for (size_t i = 0; i < codeBlock->numberOfFunctionDecls(); ++i)
+        visit(codeBlock->functionDecl(i));
+    for (size_t i = 0; i < codeBlock->numberOfFunctionExprs(); ++i)
+        visit(codeBlock->functionExpr(i));
+}
+
+unsigned eagerlyCompileNestedFunctionsForCache(VM& vm, UnlinkedCodeBlock* codeBlock, const SourceCode& source, OptionSet<CodeGenerationMode> codeGenerationMode)
+{
+    unsigned compiled = 0;
+    eagerlyCompileNestedFunctions(vm, codeBlock, source, codeGenerationMode, compiled, 0);
+    return compiled;
+}
+
+// wk26: after encoding, drop the eagerly compiled nested code blocks to free memory;
+// functions that run are recompiled lazily. The cached file is unaffected.
+
+
+unsigned releaseEagerlyCompiledNestedFunctions(VM& vm, UnlinkedCodeBlock* codeBlock)
+{
+    if (!codeBlock)
+        return 0;
+    unsigned released = 0;
+    auto drop = [&](UnlinkedFunctionExecutable* executable) {
+        if (!executable || executable->isBuiltinFunction())
+            return;
+        executable->clearCode(vm); // no-op on an executable that has no code
+        released++;
+    };
+    for (size_t i = 0; i < codeBlock->numberOfFunctionDecls(); ++i)
+        drop(codeBlock->functionDecl(i));
+    for (size_t i = 0; i < codeBlock->numberOfFunctionExprs(); ++i)
+        drop(codeBlock->functionExpr(i));
+    if (released)
+        vm.heap.reportAbandonedObjectGraph();
+    return released;
+}
